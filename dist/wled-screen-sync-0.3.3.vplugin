{"format":"vetro-plugin","version":1,"manifest":{"id":"wled-screen-sync","name":"Ambilight Studio","version":"0.3.3","apiVersion":1,"permissions":["exec"],"author":"KalelAlx","description":"Discovers WLED controllers on the local network and syncs TV colors to the selected controller over DDP.","main":"index.js","ui":{"label":"Ambilight Studio"}},"files":{"Colour.cs":"using System;\nusing System.Diagnostics;\nusing System.Net.Sockets;\nusing System.Runtime.InteropServices;\n\ninternal static class WledAmbiPpi\n{\n    [DllImport(\"libvconf.so.0\", EntryPoint=\"vconf_get_int\", CharSet=CharSet.Ansi)]\n    private static extern int VconfGetInt(string key, out int value);\n    [DllImport(\"libdl.so.2\", EntryPoint = \"dlopen\", CharSet = CharSet.Ansi)]\n    private static extern IntPtr dlopen(string filename, int flags);\n    [DllImport(\"libdl.so.2\", EntryPoint = \"dlsym\", CharSet = CharSet.Ansi)]\n    private static extern IntPtr dlsym(IntPtr handle, string symbol);\n    [UnmanagedFunctionPointer(CallingConvention.Cdecl)] private delegate int CondFn(IntPtr buf);\n    [UnmanagedFunctionPointer(CallingConvention.Cdecl)] private delegate int PosFn(int slot, int x, int y);\n    [UnmanagedFunctionPointer(CallingConvention.Cdecl)] private delegate int PixFn(int slot, IntPtr buf);\n    private static PosFn _pos; private static PixFn _pix;\n    private static int _slots, _blkW, _blkH, _sleepMs, _fullW, _fullH;\n    private static IntPtr _colBuf;\n    private static bool _ppiReady, _ppiDead;\n\n    private static bool PpiVeInit()\n    {\n        if (_ppiReady) return true;\n        if (_ppiDead) return false;   // lib nao tem a API nessa firmware: tenta uma vez so\n        IntPtr lib = dlopen(\"/usr/lib/libvideoenhance.so\", 2);\n        if (lib == IntPtr.Zero) lib = dlopen(\"libvideoenhance.so\", 1);\n        if (lib == IntPtr.Zero) { Console.WriteLine(\"ppiVe: dlopen fail\"); return false; }\n        IntPtr fc = dlsym(lib, \"cs_ve_get_rgb_measure_condition\");\n        IntPtr fp = dlsym(lib, \"cs_ve_set_rgb_measure_position\");\n        IntPtr fx = dlsym(lib, \"cs_ve_get_rgb_measure_pixel\");\n        if (fc == IntPtr.Zero || fp == IntPtr.Zero || fx == IntPtr.Zero)\n        { _ppiDead = true; Console.WriteLine(\"ppiVe: dlsym fail (API ausente nesta firmware)\"); return false; }\n        IntPtr cb = Marshal.AllocHGlobal(256);\n        Marshal.Copy(new byte[256], 0, cb, 256);\n        int rc = Marshal.GetDelegateForFunctionPointer<CondFn>(fc)(cb);\n        if (rc < 0) { Marshal.FreeHGlobal(cb); Console.WriteLine(\"ppiVe: cond rc=\" + rc); return false; }\n        _slots = Marshal.ReadInt32(cb, 0); _blkW = Marshal.ReadInt32(cb, 4);\n        _blkH = Marshal.ReadInt32(cb, 8); _sleepMs = Marshal.ReadInt32(cb, 12);\n        _fullW = Marshal.ReadInt32(cb, 16); _fullH = Marshal.ReadInt32(cb, 20);\n        Marshal.FreeHGlobal(cb);\n        if (_slots <= 0 || _fullW <= 0) { Console.WriteLine(\"ppiVe: bad cond\"); return false; }\n        if (_slots > 16) _slots = 16;\n        if (_sleepMs < 1) _sleepMs = 20;\n        _pos = Marshal.GetDelegateForFunctionPointer<PosFn>(fp);\n        _pix = Marshal.GetDelegateForFunctionPointer<PixFn>(fx);\n        _colBuf = Marshal.AllocHGlobal(256);\n        _ppiReady = true;\n        Console.WriteLine(\"ppiVe ready: slots=\" + _slots + \" block=\" + _blkW + \"x\" + _blkH +\n            \" settle=\" + _sleepMs + \"ms full=\" + _fullW + \"x\" + _fullH);\n        return true;\n    }\n\n    // Test opposite borders on the uncropped panel. Keep the previous crop\n    // through fades and require the same boundary on two different scan lines.\n    private sealed class Border\n    {\n        private static readonly double[] Depth = {0.018, 0.065, 0.115, 0.155, 0.205, 0.255};\n        public double Inset;\n        private int depth, candidate = -1, votes, line;\n        public void Probe(bool vertical)\n        {\n            double cross = line == 0 ? 0.36 : 0.64;\n            int bright = 0, dark = 0;\n            for (int first = 0; first < 2; first += _slots)\n            {\n                int count = Math.Min(_slots, 2 - first);\n                for (int i = 0; i < count; i++)\n                {\n                    double pos = first+i == 0 ? Depth[depth] : 1-Depth[depth];\n                    if (_pos(i,(int)((vertical ? cross : pos)*_fullW),(int)((vertical ? pos : cross)*_fullH)) < 0) return;\n                }\n                System.Threading.Thread.Sleep(_sleepMs);\n                for (int i = 0; i < count; i++)\n                {\n                    if (_pix(i,_colBuf) < 0) return;\n                    int peak = Math.Max(Marshal.ReadInt32(_colBuf),Math.Max(Marshal.ReadInt32(_colBuf,4),Marshal.ReadInt32(_colBuf,8))) >> 2;\n                    if (peak <= 8) dark++;\n                    if (peak >= 20) bright++;\n                }\n            }\n            if (dark == 2 && depth+1 < Depth.Length) { depth++; return; }\n            int observed = (depth == 0 ? bright > 0 : bright == 2) ? depth : -1;\n            if (observed != candidate) { candidate = observed; votes = 0; }\n            if (observed >= 0 && ++votes >= 2)\n                Inset = observed == 0 ? 0 : Depth[observed];\n            depth = 0;\n            line ^= 1;\n        }\n    }\n    private static readonly Border Rows = new Border(), Columns = new Border();\n\n    private static readonly double[][] SpotFrac = new double[][] {\n        new double[]{0.10,0.02}, new double[]{0.30,0.02}, new double[]{0.50,0.02}, new double[]{0.70,0.02}, new double[]{0.90,0.02},\n        new double[]{0.98,0.15}, new double[]{0.98,0.50}, new double[]{0.98,0.85},\n        new double[]{0.90,0.98}, new double[]{0.70,0.98}, new double[]{0.50,0.98}, new double[]{0.30,0.98}, new double[]{0.10,0.98},\n        new double[]{0.02,0.85}, new double[]{0.02,0.50}, new double[]{0.02,0.15},\n    };\n\n    private static readonly int[] FullRegions = { 5, 3, 5, 3 };\n\n    private static readonly int[] fallbackRgb = new int[SpotFrac.Length * 3];\n    private static bool fallbackInitialized;\n    private static volatile Tuning tuning = new Tuning();\n    private static bool hdr;\n    private static long pictureRecoveryUntil;\n    private static string recoveryFile;\n    private static readonly int[] FourSpots = {2,6,10,14};\n    private static readonly int[] EightSpots = {1,3,5,7,9,11,13,15};\n    private static readonly int[] FourRegions = {1,1,1,1}, EightRegions = {2,2,2,2};\n    private static byte[] PpiVeFrame()\n    {\n        int n = tuning.Fallback;\n        int[] indices = n==4 ? FourSpots : n==8 ? EightSpots : null;\n        int[] counts = n==4 ? FourRegions : n==8 ? EightRegions : FullRegions;\n        var rgb = fallbackRgb;\n        for (int base_ = 0; base_ < n; base_ += _slots)\n        {\n            int cnt = Math.Min(_slots, n - base_);\n            for (int s = 0; s < cnt; s++)\n            {\n                int x = (int)((Columns.Inset + SpotFrac[indices == null ? base_ + s : indices[base_ + s]][0] * (1 - 2 * Columns.Inset)) * _fullW);\n                int y = (int)((Rows.Inset + SpotFrac[indices == null ? base_ + s : indices[base_ + s]][1] * (1 - 2 * Rows.Inset)) * _fullH);\n                if (_pos(s, x, y) < 0) throw new InvalidOperationException(\"Position unavailable\");\n            }\n            System.Threading.Thread.Sleep(_sleepMs);\n            for (int s = 0; s < cnt; s++)\n            {\n                Marshal.Copy(new byte[256], 0, _colBuf, 256);\n                if (_pix(s, _colBuf) < 0) throw new InvalidOperationException(\"Color unavailable\");\n                {\n                    int i = base_ + s;\n                    rgb[i * 3] = Marshal.ReadInt32(_colBuf, 0) >> 2;   // 10-bit -> 8-bit\n                    rgb[i * 3 + 1] = Marshal.ReadInt32(_colBuf, 4) >> 2;\n                    rgb[i * 3 + 2] = Marshal.ReadInt32(_colBuf, 8) >> 2;\n                }\n            }\n            if (base_ + cnt == n || fallbackInitialized) {\n                var mapped = MapRegions(rgb, counts);\n                if(tuning.SampleMode==\"whole\") ApplyWholeStrip(mapped);\n                if(tuning.SampleMode==\"side\") ApplySides(mapped);\n                if(tuning.SampleMode==\"accent\" || tuning.SampleMode==\"highlight\")\n                    SelectSideSamples(mapped, tuning.SampleMode==\"accent\");\n                latest = mapped;\n            }\n        }\n        fallbackInitialized = true;\n        return latest;\n    }\n\n    private static byte[] MapRegions(int[] rgb, int[] spotN)\n    {\n        // Map the measured regions to their physical edge in strip order.\n        var leds = new byte[LedCount * 3];\n        int[] counts = { TopN, RightN, BottomN, LeftN };\n        int sp = 0, li = 0;\n        for (int e = 0; e < 4; e++)\n        {\n            for (int i = 0; i < counts[e]; i++)\n            {\n                int si = sp + Math.Min(spotN[e] - 1, i * spotN[e] / counts[e]);\n                leds[li * 3] = (byte)rgb[si * 3]; leds[li * 3 + 1] = (byte)rgb[si * 3 + 1]; leds[li * 3 + 2] = (byte)rgb[si * 3 + 2];\n                li++;\n            }\n            sp += spotN[e];\n        }\n        return leds;\n    }\n\n    private const int LedCount = TopN + RightN + BottomN + LeftN;\n    private const int TopN = 172, RightN = 97, BottomN = 172, LeftN = 97;\n\n    private static string frameStatus;\n    private static uint pictureSignature;\n    private static int pictureWidth, pictureHeight;\n    private static int zoneSampleFrame;\n    private static double inputChroma, averagedChroma;\n    private static double planeMilliseconds;\n\n    private static bool TryReadSourceType(out int source)\n    {\n        source=0;\n        try { return VconfGetInt(\"memory/system/source_type\",out source)==0 && source>=0; }\n        catch { return false; }\n    }\n\n    private static readonly PictureBorder PictureRows = new PictureBorder();\n    private static readonly PictureBorder PictureColumns = new PictureBorder();\n\n    private sealed class PictureBorder\n    {\n        private int candidate, votes;\n        public int Inset { get; private set; }\n\n        public unsafe void Scan(byte* luma, int stride, int length, int crossLength, bool rows)\n        {\n            int observed = 0;\n            for (int depth = 0; depth < length / 4; depth++)\n            {\n                int nearBright = 0, farBright = 0;\n                for (int sample = 1; sample <= 15; sample++)\n                {\n                    int cross = sample * crossLength / 16;\n                    int far = length - 1 - depth;\n                    if (luma[rows ? depth * stride + cross : cross * stride + depth] > 24) nearBright++;\n                    if (luma[rows ? far * stride + cross : cross * stride + far] > 24) farBright++;\n                }\n                if (nearBright >= 4 || farBright >= 4)\n                {\n                    if (depth > 1 && (nearBright < 4 || farBright < 4)) return;\n                    observed = depth <= 1 ? 0 : depth;\n                    if (Math.Abs(candidate - observed) > 2) { candidate = observed; votes = 0; }\n                    if (++votes >= 3) Inset = candidate;\n                    return;\n                }\n            }\n        }\n    }\n\n    private static unsafe bool ReadPlane()\n    {\n        var frame = TizenAmbilight.VideoPlaneCapture.Capture();\n        if (!frame.HasFrame || frame.RetWidth < 384 || frame.RetHeight < 216 || frame.RetWidth > 960 || frame.RetHeight > 540)\n        {\n            frameStatus = frame.Status;\n            return false;\n        }\n        planeMilliseconds += frame.CaptureMs;\n        pictureWidth = frame.W;\n        pictureHeight = frame.H;\n        byte* luma = (byte*)TizenAmbilight.VideoPlaneCapture.LumaBuffer.ToPointer();\n        byte* chroma = (byte*)TizenAmbilight.VideoPlaneCapture.ChromaBuffer.ToPointer();\n        bool cropRows = tuning.Bars == \"both\" || tuning.Bars == \"rows\";\n        bool cropColumns = tuning.Bars == \"both\" || tuning.Bars == \"columns\";\n        if (cropRows) PictureRows.Scan(luma, frame.YStride, frame.H, frame.W, true);\n        if (cropColumns) PictureColumns.Scan(luma, frame.YStride, frame.W, frame.H, false);\n        int left = cropColumns ? Math.Min(PictureColumns.Inset, frame.W / 4) : 0;\n        int top = cropRows ? Math.Min(PictureRows.Inset, frame.H / 4) : 0;\n        int width = frame.W - 2 * left, height = frame.H - 2 * top;\n        uint fingerprint = 2166136261;\n        for (int j=0;j<frame.YStride*frame.H;j+=251)\n            fingerprint = unchecked((fingerprint ^ luma[j])*16777619);\n        for (int j=0;j<frame.CStride*frame.H/2;j+=251)\n            fingerprint = unchecked((fingerprint ^ chroma[j])*16777619);\n        pictureSignature = fingerprint;\n        bool measure = (++zoneSampleFrame % 32 == 0);\n        var zoneColors = new byte[tuning.EffectiveZones * 3];\n        var pixels = new byte[LedCount * 3];\n        var sampleY = new int[4];\n        var sampleU = new int[4];\n        var sampleV = new int[4];\n        long wholeY=0, wholeU=0, wholeV=0;\n        for (int zone = 0; zone < tuning.EffectiveZones; zone++)\n        {\n            int i = zone * LedCount / tuning.EffectiveZones;\n            bool horizontal = i < TopN || (i >= TopN + RightN && i < LedCount - LeftN);\n            int x, y, dx = 0, dy = 0;\n            if (i < TopN) { x = left + (2*i+1)*width/(2*TopN); y = top+1; dy = 1; }\n            else if (i < TopN+RightN) { y = top+(2*(i-TopN)+1)*height/(2*RightN); x = left+width-2; dx = -1; }\n            else if (horizontal) { x = left+width-1-(2*(i-TopN-RightN)+1)*width/(2*BottomN); y = top+height-2; dy = -1; }\n            else { y = top+height-1-(2*(i-LedCount+LeftN)+1)*height/(2*LeftN); x = left+1; dx = 1; }\n            int lum=0, u=0, v=0;\n            for (int sample=0; sample<4; sample++)\n            {\n                int depth = sample*tuning.Depth/4;\n                int px=x+dx*depth, py=y+dy*depth;\n                int uv=(py/2)*frame.CStride+(px & ~1);\n                int yValue=luma[py*frame.YStride+px];\n                int uValue=chroma[uv], vValue=chroma[uv+1];\n                sampleY[sample]=yValue;sampleU[sample]=uValue;sampleV[sample]=vValue;\n                if (measure) inputChroma += Math.Sqrt((uValue-128)*(uValue-128)+(vValue-128)*(vValue-128));\n            }\n            AggregateSamples(sampleY,sampleU,sampleV,out lum,out u,out v);\n            int l=298*(lum-64), cb=u-512, cr=v-512;\n            if (measure) averagedChroma += Math.Sqrt(cb*cb+cr*cr);\n            if(tuning.SampleMode==\"whole\") {\n                wholeY+=lum; wholeU+=u; wholeV+=v;\n                continue;\n            }\n            if (hdr)\n            {\n                // The reference patches established limited-range codes on this TV.\n                int yy = Math.Max(0,Math.Min(255,(int)Math.Round((lum-64)*255.0/876)));\n                int uu = 128+(int)Math.Round(cb*255.0/896);\n                int vv = 128+(int)Math.Round(cr*255.0/896);\n                TizenAmbilight.VideoPlaneCapture.YuvToRgb(yy,uu,vv,1,1,1,1,true,true,\n                    out zoneColors[3*zone],out zoneColors[3*zone+1],out zoneColors[3*zone+2]);\n            }\n            else\n            {\n                zoneColors[3*zone]=Channel(l+459*cr);\n                zoneColors[3*zone+1]=Channel(l-55*cb-136*cr);\n                zoneColors[3*zone+2]=Channel(l+541*cb);\n            }\n        }\n        if(tuning.SampleMode==\"whole\") {\n            int lum=(int)((wholeY+tuning.EffectiveZones/2)/tuning.EffectiveZones);\n            int u=(int)((wholeU+tuning.EffectiveZones/2)/tuning.EffectiveZones);\n            int v=(int)((wholeV+tuning.EffectiveZones/2)/tuning.EffectiveZones);\n            int l=298*(lum-64), cb=u-512, cr=v-512;\n            byte red,green,blue;\n            if(hdr) {\n                int yy=Math.Max(0,Math.Min(255,(int)Math.Round((lum-64)*255.0/876)));\n                int uu=128+(int)Math.Round(cb*255.0/896), vv=128+(int)Math.Round(cr*255.0/896);\n                TizenAmbilight.VideoPlaneCapture.YuvToRgb(yy,uu,vv,1,1,1,1,true,true,out red,out green,out blue);\n            } else {\n                red=Channel(l+459*cr); green=Channel(l-55*cb-136*cr); blue=Channel(l+541*cb);\n            }\n            for(int i=0;i<LedCount;i++){pixels[i*3]=red;pixels[i*3+1]=green;pixels[i*3+2]=blue;}\n            latest=pixels;\n            frameStatus=frame.W+\"x\"+frame.H+\" video plane\";\n            return true;\n        }\n        for (int i=0;i<LedCount;i++)\n        {\n            int src = (i * tuning.EffectiveZones / LedCount) * 3;\n            pixels[3*i]=zoneColors[src];pixels[3*i+1]=zoneColors[src+1];pixels[3*i+2]=zoneColors[src+2];\n        }\n        if(tuning.SampleMode==\"side\") ApplySides(pixels);\n        latest = pixels;\n        frameStatus = frame.W + \"x\" + frame.H + \" video plane\";\n        return true;\n    }\n\n    private static void AggregateSamples(int[] ys,int[] us,int[] vs,out int y,out int u,out int v)\n    {\n        bool accent = tuning.SampleMode == \"accent\";\n        if (accent || tuning.SampleMode == \"highlight\")\n        {\n            int best = 0, bestScore = -1;\n            for (int i = 0; i < ys.Length; i++) {\n                int cb = us[i] - 128, cr = vs[i] - 128;\n                int score = accent ? cb * cb + cr * cr : ys[i];\n                if (score > bestScore) { bestScore = score; best = i; }\n            }\n            y = ys[best] * 4; u = us[best] * 4; v = vs[best] * 4;\n            return;\n        }\n        if(tuning.SampleMode==\"edge\" || tuning.SampleMode==\"inner\")\n        {\n            int i=tuning.SampleMode==\"edge\"?0:3;\n            y=ys[i]*4;u=us[i]*4;v=vs[i]*4;\n            return;\n        }\n        if(tuning.SampleMode==\"median\")\n        {\n            y=Median4(ys[0],ys[1],ys[2],ys[3])*4;\n            u=Median4(us[0],us[1],us[2],us[3])*4;\n            v=Median4(vs[0],vs[1],vs[2],vs[3])*4;\n            return;\n        }\n        if(tuning.SampleMode==\"weighted\")\n        {\n            y=(ys[0]*4+ys[1]*3+ys[2]*2+ys[3]+5)/10*4;\n            u=(us[0]*4+us[1]*3+us[2]*2+us[3]+5)/10*4;\n            v=(vs[0]*4+vs[1]*3+vs[2]*2+vs[3]+5)/10*4;\n            return;\n        }\n        y=ys[0]+ys[1]+ys[2]+ys[3];\n        u=us[0]+us[1]+us[2]+us[3];\n        v=vs[0]+vs[1]+vs[2]+vs[3];\n    }\n    private static int Median4(int a,int b,int c,int d)\n    {\n        int low=Math.Min(Math.Min(a,b),Math.Min(c,d));\n        int high=Math.Max(Math.Max(a,b),Math.Max(c,d));\n        return (a+b+c+d-low-high+1)/2;\n    }\n\n    private static readonly int[] SideLengths = { TopN, RightN, BottomN, LeftN };\n    // The fallback sampler has one depth per spot. Choose among spots on each side.\n    private static void SelectSideSamples(byte[] pixels, bool accent)\n    {\n        int start = 0;\n        foreach (int length in SideLengths) {\n            int best = start, bestScore = -1;\n            for (int i = start; i < start + length; i++) {\n                int r = pixels[3*i], g = pixels[3*i+1], b = pixels[3*i+2];\n                int score = accent ? Math.Max(r, Math.Max(g,b)) - Math.Min(r, Math.Min(g,b))\n                                   : 54*r + 183*g + 19*b;\n                if (score > bestScore) { bestScore = score; best = i; }\n            }\n            for (int i = start; i < start + length; i++)\n                Buffer.BlockCopy(pixels, 3*best, pixels, 3*i, 3);\n            start += length;\n        }\n    }\n    private static void ApplySides(byte[] pixels)\n    {\n        int start = 0;\n        foreach (int length in SideLengths) {\n            for (int channel = 0; channel < 3; channel++) {\n                int total = 0;\n                for (int i = start; i < start + length; i++) total += pixels[3*i + channel];\n                byte average = (byte)((total + length / 2) / length);\n                for (int i = start; i < start + length; i++) pixels[3*i + channel] = average;\n            }\n            start += length;\n        }\n    }\n\n    private static void ApplyWholeStrip(byte[] pixels)\n    {\n        int red=0,green=0,blue=0;\n        for(int i=0;i<pixels.Length;i+=3){red+=pixels[i];green+=pixels[i+1];blue+=pixels[i+2];}\n        int count=pixels.Length/3;\n        byte r=(byte)((red+count/2)/count),g=(byte)((green+count/2)/count),b=(byte)((blue+count/2)/count);\n        for(int i=0;i<pixels.Length;i+=3){pixels[i]=r;pixels[i+1]=g;pixels[i+2]=b;}\n    }\n\n    private static byte Channel(int scaled) { return (byte)Math.Max(0,Math.Min(255,(scaled+512)>>10)); }\n\n    private static volatile byte[] latest;\n\n\n\n    private static void Capture()\n    {\n        int scans = 0, changed = 0, phase = 0;\n        TizenAmbilight.VideoPlaneCapture.SetRequestSize(960, 540);\n        frameStatus = TizenAmbilight.VideoPlaneCapture.Init();\n        bool available = frameStatus == null;\n        double deadline = 0;\n        var uptime = Stopwatch.StartNew();\n        double retryMs = 0, nextHdrRead = 0;\n        string hdrFile = System.IO.Path.Combine(AppContext.BaseDirectory,\"hdr-state\");\n        recoveryFile = System.IO.Path.Combine(AppContext.BaseDirectory,\"picture-recovery-until\");\n        int consecutiveFailures = 0, planeErrors = 0, fallbackErrors = 0;\n        int sourceType=0, candidateSource=0, candidateVotes=0, nativeReopens=0;\n        bool haveSource=TryReadSourceType(out sourceType);\n        double nextSourcePoll=0, nextRecoveryReset=0, nextInitRetry=0;\n        double longestReadMs = 0;\n        var window = Stopwatch.StartNew();\n        while (true)\n        {\n            var previous = latest;\n            double started = uptime.Elapsed.TotalMilliseconds;\n            if(started>=nextSourcePoll) {\n                int observed;\n                if(TryReadSourceType(out observed)) {\n                    if(!haveSource) { sourceType=observed; haveSource=true; candidateVotes=0; }\n                    else if(observed==sourceType) candidateVotes=0;\n                    else if(candidateVotes>0 && observed==candidateSource) {\n                        candidateVotes++;\n                        if(candidateVotes>=2) {\n                            int previousSource=sourceType;\n                            sourceType=observed; candidateVotes=0;\n                            frameStatus=TizenAmbilight.VideoPlaneCapture.Reset();\n                            available=frameStatus==null;\n                            nativeReopens++;\n                            nextRecoveryReset=started+15000;\n                            nextInitRetry=started+5000;\n                            consecutiveFailures=0; fallbackInitialized=false; retryMs=0;\n                            Console.WriteLine(\"TV source changed \"+previousSource+\" -> \"+sourceType+\"; reopened video-plane capture: \"+(frameStatus??\"ready\"));\n                        }\n                    } else { candidateSource=observed; candidateVotes=1; }\n                }\n                nextSourcePoll=started+250;\n            }\n            if(!available && started>=nextInitRetry) {\n                frameStatus=TizenAmbilight.VideoPlaneCapture.Init();\n                available=frameStatus==null;\n                nextInitRetry=started+5000;\n            }\n            if (started >= nextHdrRead)\n            {\n                var old = tuning;\n                tuning = Tuning.Read(old);\n                if (old.Fallback != tuning.Fallback || old.EffectiveZones != tuning.EffectiveZones) fallbackInitialized = false;\n                TizenAmbilight.VideoPlaneCapture.HdrPeakNits = tuning.Reference;\n                try {\n                    long recoveryDeadline;\n                    if(long.TryParse(System.IO.File.ReadAllText(recoveryFile).Trim(),out recoveryDeadline))\n                        pictureRecoveryUntil=recoveryDeadline;\n                    else pictureRecoveryUntil=0;\n                } catch(System.IO.IOException) { pictureRecoveryUntil=0; }\n                try { hdr = System.IO.File.ReadAllText(hdrFile).Trim() == \"1\"; }\n                catch (System.IO.IOException) {}\n                if(tuning.Hdr!=\"auto\") hdr=tuning.Hdr==\"on\";\n                if(tuning.Bars==\"off\" || tuning.Bars==\"columns\") Rows.Inset=0;\n                if(tuning.Bars==\"off\" || tuning.Bars==\"rows\") Columns.Inset=0;\n                nextHdrRead = started + 1000;\n            }\n            uint oldSignature = pictureSignature;\n            bool samplerOnly = tuning.Source==\"sampler\";\n            bool attempt = !samplerOnly && available && started >= retryMs;\n            bool full = attempt && ReadPlane();\n            if (attempt)\n            {\n                longestReadMs = Math.Max(longestReadMs, uptime.Elapsed.TotalMilliseconds - started);\n                if (full) {\n                    consecutiveFailures = 0; fallbackInitialized = false;\n                    if(pictureRecoveryUntil!=0) {\n                        pictureRecoveryUntil=0;\n                        try { System.IO.File.Delete(recoveryFile); } catch(System.IO.IOException) {}\n                    }\n                }\n                else\n                {\n                    planeErrors++;\n                    consecutiveFailures++;\n                    if(consecutiveFailures>=3 && started>=nextRecoveryReset) {\n                        frameStatus=TizenAmbilight.VideoPlaneCapture.Reset();\n                        available=frameStatus==null;\n                        nativeReopens++;\n                        nextRecoveryReset=started+15000;\n                        nextInitRetry=started+5000;\n                        retryMs=uptime.Elapsed.TotalMilliseconds+500;\n                        Console.WriteLine(\"video-plane recovery reopen \"+nativeReopens+\": \"+(frameStatus??\"ready\"));\n                    }\n                    double delay = consecutiveFailures < 3 ? 0 : 500;\n                    retryMs = uptime.Elapsed.TotalMilliseconds + delay;\n                }\n            }\n            bool pictureRecovery = pictureRecoveryUntil > DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();\n            if (!full && !pictureRecovery && (samplerOnly || !available || consecutiveFailures >= 3))\n            {\n                try { latest = PpiVeFrame(); }\n                catch (InvalidOperationException) { fallbackErrors++; }\n            }\n            bool difference = false;\n            var colors = latest;\n            for (int i = 0; i < colors.Length && !difference; i++)\n                difference = colors[i] != previous[i];\n            if (full ? oldSignature != pictureSignature : difference) changed++;\n            if (!full && phase % 8 == 0 && (tuning.Bars==\"both\" || tuning.Bars==\"rows\")) Rows.Probe(true);\n            if (!full && phase % 8 == 4 && (tuning.Bars==\"both\" || tuning.Bars==\"columns\")) Columns.Probe(false);\n            phase = (phase + 1) % 8;\n            deadline += 1000.0 / (full ? tuning.CaptureHz : 25);\n            double remaining = deadline - uptime.Elapsed.TotalMilliseconds;\n            if (remaining < -20) deadline = uptime.Elapsed.TotalMilliseconds;\n            if (remaining > 0) System.Threading.Thread.Sleep((int)Math.Ceiling(remaining));\n            scans++;\n            if (window.ElapsedMilliseconds < 5000) continue;\n            string status = String.Format(\"{0}, {1} slots at {2} ms, {7} regions, capture {3:F2}/s, changed {4:F2}/s, {8} output target, top/bottom inset {5:P1}, side inset {6:P1}, plane read {9:F1}ms\",\n                samplerOnly ? \"Selected TV sampler\" : frameStatus, _slots, _sleepMs, scans / window.Elapsed.TotalSeconds, changed / window.Elapsed.TotalSeconds, full ? (tuning.Bars==\"both\" || tuning.Bars==\"rows\" ? (double)PictureRows.Inset / pictureHeight : 0) : Rows.Inset, full ? (tuning.Bars==\"both\" || tuning.Bars==\"columns\" ? (double)PictureColumns.Inset / pictureWidth : 0) : Columns.Inset, full ? tuning.EffectiveZones : tuning.Fallback, tuning.SendHz, planeMilliseconds/scans);\n            status += String.Format(\", plane errors {0}, fallback errors {1}, longest read {2:F0} ms, UDP errors {3}\",\n                planeErrors, fallbackErrors, longestReadMs, System.Threading.Interlocked.CompareExchange(ref udpErrors,0,0));\n            status += \", WLED \" + tuning.Wled;\n            status += \", TV input \" + (haveSource ? sourceType.ToString() : \"unknown\") + \", capture reopens \" + nativeReopens;\n            status += full ? (hdr ? \", HDR10 PQ BT.2020\" : \", SDR BT.709\") : pictureRecovery ? \", trying full-picture recovery\" : \", TV sampled RGB\";\n            status += \", saturation \" + tuning.Saturation + \"%, smoothing \" + tuning.Smooth + \" ms, sampling \" + tuning.SampleMode;\n            if (inputChroma > 0) status += String.Format(\", zone chroma cancellation {0:F1}%\",100*(1-averagedChroma/inputChroma));\n            inputChroma = averagedChroma = 0;\n            longestReadMs = 0;\n            planeMilliseconds = 0;\n            changed = 0;\n            try { System.IO.File.WriteAllText(\"/tmp/ambilight-studio-rate\", status); }\n            catch (System.IO.IOException) {}\n            scans = 0;\n            window.Restart();\n        }\n    }\n\n    private static int Main(string[] args)\n    {\n        tuning = Tuning.Read(tuning);\n        if (!PpiVeInit()) return 1;\n        latest = new byte[LedCount * 3];\n        var current = Array.ConvertAll(latest, value => (double)value);\n        var capture = new System.Threading.Thread(Capture) { IsBackground = true };\n        capture.Start();\n        var pixels = new byte[current.Length];\n        var clock = Stopwatch.StartNew();\n        double nextPreview = 0;\n        double previous = 0;\n        double next = 0;\n        using (var udp = new UdpClient())\n        {\n            System.Net.IPEndPoint endpoint = null;\n            string destination = null;\n            while (true)\n            {\n                double now = clock.Elapsed.TotalMilliseconds;\n                var config = tuning;\n                if (config.Lighting==\"audio\") {\n                    System.Threading.Thread.Sleep(100);\n                    next=previous=clock.Elapsed.TotalMilliseconds;\n                    continue;\n                }\n                double blend = config.Smooth==0 ? 1 : 1 - Math.Exp(-(now - previous) / config.Smooth);\n                previous = now;\n                var target = latest;\n                for (int i = 0; i < pixels.Length; i++)\n                {\n                    current[i] += (target[i] - current[i]) * blend;\n                    pixels[i] = (byte)Math.Round(current[i]);\n                }\n                if (config.Lighting != \"screen\") RenderManual(pixels,config,now);\n                config.Apply(pixels);\n                int port = config.Protocol==\"dnrgb\" ? 21324 : 4048;\n                if (destination != config.Wled || endpoint.Port != port) { endpoint = new System.Net.IPEndPoint(System.Net.IPAddress.Parse(config.Wled),port); destination = config.Wled; }\n                try {\n                    bool previewDue = now >= nextPreview;\n                    byte[] preview = previewDue ? new byte[48 * 3] : null;\n                    SendDdp(udp, endpoint, pixels, config, preview);\n                    if (previewDue) {\n                        nextPreview = now + 1000;\n                        try { System.IO.File.WriteAllText(\"/tmp/ambilight-studio-preview\", Convert.ToBase64String(preview)); }\n                        catch (System.IO.IOException) { }\n                    }\n                }\n                catch (SocketException) { System.Threading.Interlocked.Increment(ref udpErrors); }\n                next += 1000.0 / config.SendHz;\n                double remaining = next - clock.Elapsed.TotalMilliseconds;\n                if (remaining > 0) System.Threading.Thread.Sleep((int)Math.Ceiling(remaining));\n                else next = clock.Elapsed.TotalMilliseconds;\n            }\n        }\n    }\n    private static void RenderManual(byte[] pixels,Tuning config,double now)\n    {\n        double phase = (now / (1000 * config.Period)) % 1;\n        double pulse = config.Lighting==\"breathe\" ? 0.5-0.5*Math.Cos(2*Math.PI*phase) : 1;\n        for (int i=0;i<LedCount;i++) {\n            double gain=pulse;\n            if(config.Lighting==\"wave\") gain=0.5+0.5*Math.Cos(2*Math.PI*(3.0*i/LedCount-phase));\n            if(config.Lighting==\"twinkle\" || config.Lighting==\"spark\") {\n                bool firefly=config.Lighting==\"spark\";\n                double t=now/(config.Period*(firefly?900.0:250.0));\n                int cell=firefly?i/6:i;\n                t+=(cell*0.61803398875)%1;\n                uint hash=unchecked((uint)(cell*374761393+(int)t*668265263));\n                hash=unchecked((hash^(hash>>13))*1274126177u);\n                double envelope=Math.Sin(Math.PI*(t-Math.Floor(t)));\n                gain=(hash%100 < (firefly?24:14)) ? envelope*envelope : 0.025;\n            }\n            if(config.Lighting==\"chase\") {\n                double distance=(phase-i/(double)LedCount+1)%1;\n                gain=Math.Max(0,1-5*distance);\n            }\n            for(int ch=0;ch<3;ch++) pixels[3*i+ch]=(byte)Math.Round(((config.ManualRgb>>(16-8*ch))&255)*gain);\n        }\n    }\n    private static int udpErrors;\n    private static byte sequence = 1;\n\n    private static void SendDdp(UdpClient udp, System.Net.IPEndPoint endpoint, byte[] rgb, Tuning config, byte[] preview)\n    {\n        const int ChannelsPerPacket = 1440;\n        for (int offset = 0; offset < config.Leds * 3; offset += ChannelsPerPacket)\n        {\n            int count = Math.Min(ChannelsPerPacket, config.Leds * 3 - offset);\n            if (count <= 0) break;\n            bool last = offset + count == config.Leds * 3;\n            bool raw = config.Protocol==\"dnrgb\";\n            int header = raw ? 4 : 10;\n            var packet = new byte[header + count];\n            if(raw) {\n                packet[0]=4; packet[1]=2;\n                packet[2]=(byte)((offset/3)>>8); packet[3]=(byte)(offset/3);\n            } else {\n            packet[0] = (byte)(last ? 0x41 : 0x40);\n            packet[1] = sequence;\n            sequence = (byte)(sequence % 15 + 1);\n            packet[2] = 0x0B;\n            packet[3] = 1;\n            packet[4] = (byte)(offset >> 24);\n            packet[5] = (byte)(offset >> 16);\n            packet[6] = (byte)(offset >> 8);\n            packet[7] = (byte)offset;\n            packet[8] = (byte)(count >> 8);\n            packet[9] = (byte)count;\n            }\n            // Start at the bottom-left, then travel up the left edge.\n            int corner = config.StartCorner==\"top-left\" ? 0 :\n                config.StartCorner==\"top-right\" ? config.TopCount :\n                config.StartCorner==\"bottom-right\" ? config.TopCount+config.RightCount :\n                config.Leds-config.LeftCount;\n            int firstOutputLed = offset / 3;\n            for(int j=0;j<count;j+=3) {\n                int sourceLed=(firstOutputLed+j/3)%config.Leds;\n                int logical=config.Direction==\"reverse\" ? (corner+config.Offset-sourceLed+config.Leds*2)%config.Leds : (corner+config.Offset+sourceLed)%config.Leds;\n                int position;\n                if (logical < config.TopCount) position=logical*TopN/config.TopCount;\n                else if ((logical-=config.TopCount) < config.RightCount) position=TopN+logical*RightN/config.RightCount;\n                else if ((logical-=config.RightCount) < config.BottomCount) position=TopN+RightN+logical*BottomN/config.BottomCount;\n                else position=TopN+RightN+BottomN+(logical-config.BottomCount)*LeftN/Math.Max(1,config.LeftCount);\n\n                bool? enabled = position < TopN ? config.Top : position < TopN + RightN ? config.Right :\n                    position < TopN + RightN + BottomN ? config.Bottom : config.Left;\n                if (enabled != false) Buffer.BlockCopy(rgb,position*3,packet,header+j,3);\n            }\n            udp.Send(packet, packet.Length, endpoint);\n            if (preview != null) {\n                for (int i = 0; i < preview.Length / 3; i++) {\n                    int index = (i * config.Leds / (preview.Length / 3)) * 3 - offset;\n                    if (index >= 0 && index < count) Buffer.BlockCopy(packet, header + index, preview, i * 3, 3);\n                }\n            }\n        }\n    }\n\n}\n","Colour.runtimeconfig.json":"{\n  \"runtimeOptions\": {\n    \"tfm\": \"netcoreapp3.1\",\n    \"framework\": {\n      \"name\": \"Microsoft.NETCore.App\",\n      \"version\": \"3.1.3\"\n    }\n  }\n}\n","README.md":"# Ambilight Studio\n\nSamples TV picture colors and sends them to a configured WLED controller over DDP (UDP 4048). Configure the controller's IPv4 address under WLED target. The loopback default keeps output on the TV until configured. The default strip count is 538. Full-picture capture depends on firmware and input mode. The color sampler can provide lower resolution fallback.\n\nThe predecessor, Ambilight 538, ran on a Samsung QN55QN85BAFXZC. Version 0.3.3 was installed and reported running on this TV. Game Mode and source switching can make full-picture capture unavailable.\n\n## Dashboard and discovery\n\nFind WLED controllers sends one local mDNS query for the WLED service. Select an advertisement and apply settings to change the destination. Manual IPv4 entry works when multicast is unavailable. Discovery was verified on a LAN with two controllers.\n\nThe strip monitor shows 48 samples from outgoing DDP packets in physical LED order. It refreshes once per second and clears stale output. It shows the transmitted colors, without feedback from the LEDs. Capture diagnostics show scan rate, observed changes, active zones and crop insets.\n\nColor accent picks the depth sample with the strongest chroma. Highlight picks the highest luma. With the fallback sampler, both choose among measured spots on each side (four-spot mode has only one choice per side). One color per side averages each entire edge. Whole-strip average produces one color for all LEDs.\n\n## Output and strip layout\n\nSimple view provides daily lighting controls. Advanced view adds capture diagnostics and per-side LED counts and switches. Output supports 1–4096 RGB pixels over DDP or WLED DNRGB. Screen sync samples up to 538 zones.\n\nScreen sync, Audio sync and Solid are grouped separately from Twinkle, Rolling wave, Fireflies, Breathe and Comet trail. Audio sync activates Freqwave on the selected WLED controller and uses its audio input or sync feed. The shard does not capture TV or HDMI audio.\n\n## Commands it runs\n\n- `systemctl is-active`, `stop`, `restart`, and `reset-failed` manage the shard's capture service. `systemd-run` runs the bundled helper under `/usr/bin/dotnet`.\n- `cat` reads capture statistics and preview samples. `stat` and `date` check preview freshness.\n- `busctl` queries HDR status from the TV's AV output service.\n- `curl` queries the selected controller and sets its effect through the WLED JSON API when audio sync is selected.\n\nThe helper sources are included beside the payload. Compile Colour.cs, VideoPlaneCapture.cs and Tuning.cs together with Roslyn using the Tizen .NET API 9 reference assemblies and the `-unsafe -optimize+` flags, then base64-encode Colour.exe into payload.b64.\n","Tuning.cs":"using System;\nusing System.IO;\nusing System.Runtime.Serialization;\nusing System.Runtime.Serialization.Json;\nusing System.Text;\n\n[DataContract]\ninternal sealed class Tuning\n{\n    [DataMember(IsRequired=true)] public string Hdr = \"auto\";\n    [DataMember(IsRequired=true)] public int Saturation = 100;\n    [DataMember(IsRequired=true)] public int Brightness = 100;\n    [DataMember(IsRequired=true)] public int Gamma = 100;\n    [DataMember(IsRequired=true)] public int Reference = 203;\n    [DataMember(IsRequired=true)] public int Black = 0;\n    [DataMember(IsRequired=true)] public int Red = 100;\n    [DataMember(IsRequired=true)] public int Green = 100;\n    [DataMember(IsRequired=true)] public int Blue = 100;\n    [DataMember(IsRequired=true)] public int Smooth = 125;\n    [DataMember(IsRequired=true)] public int CaptureHz = 60;\n    [DataMember(IsRequired=true)] public int SendHz = 62;\n    [DataMember(IsRequired=true)] public string Source = \"auto\";\n    [DataMember(IsRequired=true)] public int Fallback = 16;\n    [DataMember(IsRequired=true)] public string Bars = \"both\";\n    [DataMember(IsRequired=true)] public int Depth = 16;\n    [DataMember(IsRequired=true)] public string SampleMode = \"average\";\n    [DataMember(IsRequired=true)] public int Offset = 0;\n    [DataMember(IsRequired=true)] public string Direction = \"normal\";\n    [DataMember(IsRequired=true)] public string Wled = \"127.0.0.1\";\n    [DataMember(IsRequired=true)] public int Leds = 538;\n    [DataMember(IsRequired=true)] public int Zones = 512;\n    [DataMember(IsRequired=true)] public string ZonesMode = \"match\";\n    [DataMember] public string Lighting = \"screen\";\n    [DataMember] public string Protocol = \"ddp\";\n    [DataMember] public string Tint = \"#ff8844\";\n    [DataMember] public int Period = 4;\n    [DataMember] public bool? Top;\n    [DataMember] public bool? Right;\n    [DataMember] public bool? Bottom;\n    [DataMember] public bool? Left;\n    [DataMember] public int TopCount = 172;\n    [DataMember] public int RightCount = 97;\n    [DataMember] public int BottomCount = 172;\n    [DataMember] public int LeftCount = 97;\n    public int ManualRgb;\n    public int EffectiveZones { get { return ZonesMode==\"match\" ? Math.Min(538,Leds) : Zones; } }\n    [DataMember(IsRequired=true)] public string StartCorner = \"bottom-left\";\n    private byte[] redCurve, greenCurve, blueCurve;\n    private static string lastJson;\n    private static readonly string ConfigFile = Path.Combine(Path.GetDirectoryName(typeof(Tuning).Assembly.Location),\"config.json\");\n    public static Tuning Read(Tuning previous)\n    {\n        try {\n            string json=File.ReadAllText(ConfigFile);\n            if (json==lastJson) return previous;\n            using(var stream=new MemoryStream(Encoding.UTF8.GetBytes(json))) {\n                var serializer=new DataContractJsonSerializer(typeof(Tuning));\n                var t=(Tuning)serializer.ReadObject(stream);\n                if (t.SendHz<5 || t.CaptureHz<5 || t.Depth<4 || t.Offset<0 || t.Offset>4095 || t.Leds<1 || t.Leds>4096 || t.Zones<4 || t.Zones>512 || (t.ZonesMode!=\"match\" && t.ZonesMode!=\"custom\") || string.IsNullOrEmpty(t.Wled)) return previous;\n                if (t.TopCount+t.RightCount+t.BottomCount+t.LeftCount != t.Leds) return previous;\n                if (String.IsNullOrEmpty(t.Lighting)) t.Lighting=\"screen\";\n                t.Period=Math.Max(1,Math.Min(20,t.Period));\n                if (t.Tint!=null && t.Tint.Length==7) Int32.TryParse(t.Tint.Substring(1),System.Globalization.NumberStyles.HexNumber,null,out t.ManualRgb);\n                t.redCurve=t.Curve(t.Red); t.greenCurve=t.Curve(t.Green); t.blueCurve=t.Curve(t.Blue);\n                lastJson=json;\n                return t;\n            }\n        } catch(IOException) { return previous; }\n          catch(SerializationException) { return previous; }\n    }\n    private byte[] Curve(int gain)\n    {\n        var table=new byte[256];\n        for(int i=0;i<256;i++)\n            table[i]=(byte)Math.Min(255,Math.Round(255*Math.Pow(i/255.0,Gamma/100.0)*Brightness*gain/10000.0));\n        return table;\n    }\n    public void Apply(byte[] rgb)\n    {\n        if(redCurve==null || (Black==0 && Brightness==100 && Gamma==100 && Red==100 && Green==100 && Blue==100 && Saturation==100))return;\n        for(int i=0;i<rgb.Length;i+=3){\n            int r=rgb[i],g=rgb[i+1],b=rgb[i+2];\n            if(Math.Max(r,Math.Max(g,b))<=Black) {rgb[i]=rgb[i+1]=rgb[i+2]=0;continue;}\n            int y=(54*r+183*g+19*b+128)>>8;\n            rgb[i]=redCurve[Adjust(r,y)];rgb[i+1]=greenCurve[Adjust(g,y)];rgb[i+2]=blueCurve[Adjust(b,y)];\n        }\n    }\n    private int Adjust(int channel,int luma)\n    {\n        return Math.Max(0,Math.Min(255,(luma*100+(channel-luma)*Saturation+50)/100));\n    }\n}\n","VideoPlaneCapture.cs":"using System;\nusing System.Collections.Generic;\nusing System.Runtime.InteropServices;\n\nnamespace TizenAmbilight\n{\n    /// <summary>Outcome of one secvideo_api_capture_video_main call. The planes arrive in OUR\n    /// buffers — there is no file and no encoder anywhere on this path.</summary>\n    public sealed class VideoPlaneResult\n    {\n        public int Rc;                 // 0 == success for this API (measured on hardware, v15-v17)\n        public int RetWidth;           // param+0x08, written by the library\n        public int RetHeight;          // param+0x0c\n        public int YPitch;             // param+0x2c — 960 on this TV\n        public int CPitch;             // param+0x30 — 960 on this TV\n        public int YStride;            // row stride to use for the Y plane (pitch, validated)\n        public int CStride;            // row stride to use for the chroma plane\n        public int Interlaced;         // param+0x28 — 0 on this TV\n        public double CaptureMs;\n        // The planes, handed over raw. There is deliberately NO RGBA conversion here any more:\n        // converting 518,400 pixels to RGB only to average them down to 73 zone colours was the\n        // single biggest cost in the pipeline (~115 ms/frame) and it averaged in gamma-encoded\n        // space, which is not the same as averaging light. The zone engine now averages Y/U/V\n        // per zone and runs the colour matrix 73 times instead of 518,400.\n        public byte[] Y;\n        public byte[] C;\n        public int W, H;\n        public string Error;\n\n        public bool HasFrame { get { return Error == null && Rc == 0 && Y != null && C != null; } }\n\n        public string Status\n        {\n            get\n            {\n                if (Error != null) return \"vplane_error:\" + Error;\n                if (Rc != 0) return \"vplane rc=\" + Rc + \" (not ready)\";\n                if (Y == null) return \"vplane rc=0 but no planes\";\n                return \"ok \" + RetWidth + \"x\" + RetHeight + \" YUV planes in memory (\" +\n                       CaptureMs.ToString(\"0.0\") + \" ms)\";\n            }\n        }\n    }\n\n    /// <summary>\n    /// THE VIDEO PLANE, in memory. The only native entry point on this path:\n    ///\n    ///     int secvideo_api_capture_video_main(int req_w, int req_h, secvideo_capture_param*)\n    ///     from libvideo-capture.so.0.1.0  (3 args — verified from the disassembly, not assumed)\n    ///\n    /// Why this and not the alternatives (all measured on QN77S84FAEXZA, Tizen 9, 2026-09-11):\n    ///   * EPScreenCapture::capture() -> getScreenPostYUV is the SCREEN/UI plane. It goes DARK over\n    ///     video (mean 108.5 idle -> 24.7 during playback). Wrong plane for an ambilight.\n    ///   * dc_request_capture_to_file_sync works but writes a PNG file: ~126 ms/frame end to end\n    ///     (encode + write + decode) at 480x270.\n    ///   * HyperTizen samples 16 points off the video plane at ~4-12 fps.\n    ///   THIS call returns the real video plane, 960x540, into caller-owned buffers, with no file.\n    ///   During playback the frame renders as film content (verified: a title sequence with readable\n    ///   place-name text). Measured 60/60 successes in 988 ms on one run — 16.5 ms/frame — though the\n    ///   per-call cost is variable and pacing-sensitive, so treat that as best-observed, not typical.\n    ///\n    /// secvideo_capture_param layout — PROVEN from Samsung's own decompiled\n    /// Tizen.TV.System.ContentAnalysis.dll, then confirmed on device by reading back the fields the\n    /// library fills in (ret_y_pitch = 960, ret_c_pitch = 960, ret_interlaced = 0):\n    ///   +0x00 u32 uYSize      +0x04 u32 uCSize    +0x08 int ret_width   +0x0c int ret_height\n    ///   +0x10 ptr pYAddr      +0x14 ptr pCAddr    +0x18 int no_lock_no_copy\n    ///   +0x1c u32 color_format                    +0x20 u32 protected_on\n    ///   +0x24 u32 capt_3dmod  +0x28 u32 ret_interlaced  +0x2c u32 ret_y_pitch\n    ///   +0x30 u32 ret_c_pitch +0x34 u64 timestamp_nsec (ARM32 alignment of this tail is NOT trusted;\n    ///                                                     the struct is zeroed and only the four\n    ///                                                     fields the partner code itself sets are written)\n    ///\n    /// Chroma layout — settled on device: NV12 INTERLEAVED, pitch 960, non-interlaced. Confirmed two\n    /// independent ways: autocorrelation of the exfiltrated plane (lag1 = -0.95, lag2 = +0.98 =>\n    /// period-2 byte alternation) and the library's own ret_c_pitch = 960 (960 bytes/row x 270 rows\n    /// = 259200 = exactly the plane we allocate).\n    ///\n    /// SAFETY: the only native calls are dlopen/dlsym and this one function. Buffers are ours.\n    /// No file is written, no /dev node is opened here, and no lock is taken (lockGlobal was measured\n    /// to be actively harmful: 0/15 successes at ~1016 ms per call).\n    /// </summary>\n    public static class VideoPlaneCapture\n    {\n        public const string BackendName = \"video_plane\";\n        public const string LibName = \"libvideo-capture.so.0.1.0\";\n        public const string Symbol = \"secvideo_api_capture_video_main\";\n\n        // 960x540 is the size the partner (Samsung's own Tizen.TV.System.ContentAnalysis) requests,\n        // and the size that came back filled on hardware.\n        /// <summary>Maximum plane size - the size the buffers are allocated at, once, at init.\n        /// Never shrink this: the param's Y/C size fields advertise these, and a smaller request\n        /// still writes into a buffer at least this large.</summary>\n        public const int PlaneW = 960;\n        public const int PlaneH = 540;\n        public const int YBytes = PlaneW * PlaneH;      // 518400\n        public const int CBytes = YBytes / 2;           // 259200, NV12 interleaved\n\n        const int StructBytes = 256;\n\n        const int OffYSize = 0x00;\n        const int OffCSize = 0x04;\n        const int OffRetWidth = 0x08;\n        const int OffRetHeight = 0x0c;\n        const int OffYAddr = 0x10;\n        const int OffCAddr = 0x14;\n        const int OffInterlaced = 0x28;\n        const int OffYPitch = 0x2c;\n        const int OffCPitch = 0x30;\n\n        const int RTLD_LAZY = 0x00001;\n        const int RTLD_NOW = 0x00002;\n\n        [DllImport(\"libdl.so.2\", EntryPoint = \"dlopen\", CharSet = CharSet.Ansi)]\n        static extern IntPtr dlopen(string filename, int flags);\n\n        [DllImport(\"libdl.so.2\", EntryPoint = \"dlclose\")]\n        static extern int dlclose(IntPtr handle);\n\n        [DllImport(\"libdl.so.2\", EntryPoint = \"dlsym\", CharSet = CharSet.Ansi)]\n        static extern IntPtr dlsym(IntPtr handle, string symbol);\n\n        [DllImport(\"libdl.so.2\", EntryPoint = \"dlerror\")]\n        static extern IntPtr dlerror();\n\n        [UnmanagedFunctionPointer(CallingConvention.Cdecl)]\n        delegate int CaptureVideoMainFn(int reqW, int reqH, IntPtr param);\n\n        static IntPtr _lib = IntPtr.Zero;\n        static IntPtr _fn = IntPtr.Zero;\n        static IntPtr _param = IntPtr.Zero;\n        public static IntPtr LumaBuffer { get { return _bufY; } }\n        public static IntPtr ChromaBuffer { get { return _bufC; } }\n        static IntPtr _bufY = IntPtr.Zero;\n        static IntPtr _bufC = IntPtr.Zero;\n        static CaptureVideoMainFn _call;\n\n        /// <summary>Requested capture size. Configurable at runtime (control token `cw`/`ch`) because\n        /// the hardware scaler does the downsampling for us - we only ever consume 73 zone averages,\n        /// so requesting the full 960x540 may be wasted work in the capture path.</summary>\n        public static int ReqW = PlaneW;\n        public static int ReqH = PlaneH;\n\n        /// <summary>Clamp a requested size so it fits the allocated buffers: W*H <= PlaneW*PlaneH.\n        /// Returns false if the pair is unusable.</summary>\n        public static bool SetRequestSize(int w, int h)\n        {\n            if (w < 64 || h < 64) return false;\n            if ((long)w * h > (long)PlaneW * PlaneH) return false;\n            ReqW = w; ReqH = h;\n            return true;\n        }\n\n        static readonly byte[] _y = new byte[YBytes];\n        static readonly byte[] _c = new byte[CBytes];\n\n        public static string ResolvedPath = \"\";\n\n        // ---- color_format: the field we never set, and the suspected chroma gate ----\n        // secvideo_capture_param has color_format at +0x1c and we have sent 0 in every call ever\n        // made. On the first capture the app now sweeps 0..5, measures the chroma SPREAD each value\n        // produces, and keeps the best. If every value is flat the field is not the gate and the app\n        // says so in its stats/status rather than pretending colour is coming.\n        const int OffColorFormat = 0x1c;\n        public static int ChosenColorFormat = -1;\n        public static double ChosenChromaSpread = -1;\n        public static string ColorFormatVerdict = \"not probed\";\n        static bool _cfProbed;\n        public static readonly List<object> ColorFormatProbe = new List<object>();\n        public static IntPtr FunctionPointer { get { return _fn; } }\n        public static bool Ready { get { return _call != null; } }\n\n        /// <summary>Idempotent. dlopen + dlsym + allocate the param struct and both planes ONCE.\n        /// Returns null on success, or the error text.</summary>\n        public static string Init()\n        {\n            if (_call != null) return null;\n\n            try\n            {\n                IntPtr err0 = dlerror();\n                foreach (var name in new [] { LibName, \"/usr/lib/libvideo-capture.so.0\", \"/usr/lib/libsec-video-capture.so.0\", \"/usr/lib/libsec-video-capture.so.0.1.0\" }) {\n                    _lib = dlopen(name, RTLD_NOW);\n                    if (_lib == IntPtr.Zero) continue;\n                    _fn = dlsym(_lib, Symbol);\n                    Console.WriteLine(\"loaded \"+name+\" symbol=\"+(_fn != IntPtr.Zero));\n                    if (_fn != IntPtr.Zero) break;\n                }\n                if (_fn == IntPtr.Zero) return \"Video-plane function unavailable\";\n                _param = Marshal.AllocHGlobal(StructBytes);\n                _bufY = Marshal.AllocHGlobal(YBytes);\n                _bufC = Marshal.AllocHGlobal(CBytes);\n                if (_param == IntPtr.Zero || _bufY == IntPtr.Zero || _bufC == IntPtr.Zero)\n                    return \"allocation failed\";\n\n                for (int i = 0; i < StructBytes; i++) Marshal.WriteByte(_param, i, 0);\n\n                Marshal.WriteInt32(_param, OffYSize, YBytes);\n                Marshal.WriteInt32(_param, OffCSize, CBytes);\n                Marshal.WriteInt32(_param, OffYAddr, _bufY.ToInt32());\n                Marshal.WriteInt32(_param, OffCAddr, _bufC.ToInt32());\n\n                _call = (CaptureVideoMainFn)Marshal.GetDelegateForFunctionPointer(\n                            _fn, typeof(CaptureVideoMainFn));\n                return null;\n            }\n            catch (Exception e)\n            {\n                return e.GetType().Name + \": \" + e.Message;\n            }\n        }\n\n        /// <summary>Reopen the native capture library after a TV input transition. The call is made\n        /// only by the capture thread, between frames, so no native call is in flight here.</summary>\n        public static string Reset()\n        {\n            _call = null;\n            if (_param != IntPtr.Zero) Marshal.FreeHGlobal(_param);\n            if (_bufY != IntPtr.Zero) Marshal.FreeHGlobal(_bufY);\n            if (_bufC != IntPtr.Zero) Marshal.FreeHGlobal(_bufC);\n            _param = _bufY = _bufC = IntPtr.Zero;\n            _fn = IntPtr.Zero;\n            if (_lib != IntPtr.Zero) { try { dlclose(_lib); } catch {} }\n            _lib = IntPtr.Zero;\n            return Init();\n        }\n\n        /// <summary>Measure the chroma spread one color_format value produces. Returns -1 if the\n        /// call did not succeed. Settled on hardware: every value 0..5 produced byte-identical chroma,\n        /// so color_format is NOT the gate on this device.</summary>\n        static double ChromaSpreadFor(int cf)\n        {\n            Marshal.WriteInt32(_param, OffColorFormat, cf);\n            for (int i = 0; i < CBytes; i++) Marshal.WriteByte(_bufC, i, 0);   // a no-write must be visible\n            int rc = _call(ReqW, ReqH, _param);\n            var rec = new Dictionary<string, object> { { \"color_format\", (long)cf }, { \"rc\", (long)rc } };\n            if (rc != 0) { ColorFormatProbe.Add(rec); return -1; }\n\n            Marshal.Copy(_bufC, _c, 0, CBytes);\n            long us = 0, vs = 0, us2 = 0, vs2 = 0; long n = 0;\n            int umin = 255, umax = 0, vmin = 255, vmax = 0;\n            for (int i = 0; i + 1 < CBytes; i += 2)\n            {\n                byte u = _c[i], v = _c[i + 1];\n                us += u; us2 += (long)u * u; vs += v; vs2 += (long)v * v; n++;\n                if (u < umin) umin = u; if (u > umax) umax = u;\n                if (v < vmin) vmin = v; if (v > vmax) vmax = v;\n            }\n            double um = (double)us / n, vm = (double)vs / n;\n            double ust = Math.Sqrt(Math.Max(0, (double)us2 / n - um * um));\n            double vst = Math.Sqrt(Math.Max(0, (double)vs2 / n - vm * vm));\n            rec[\"U_mean\"] = Math.Round(um, 2); rec[\"U_stdev\"] = Math.Round(ust, 3);\n            rec[\"U_range\"] = umin + \"-\" + umax;\n            rec[\"V_mean\"] = Math.Round(vm, 2); rec[\"V_stdev\"] = Math.Round(vst, 3);\n            rec[\"V_range\"] = vmin + \"-\" + vmax;\n            rec[\"chroma_spread\"] = Math.Round(ust + vst, 3);\n            ColorFormatProbe.Add(rec);\n            return ust + vst;\n        }\n\n        static void ProbeColorFormatOnce()\n        {\n            _cfProbed = true;\n            if (_call == null) { ColorFormatVerdict = \"no call\"; return; }\n            double best = -1; int bestCf = 0; int ok = 0;\n            for (int cf = 0; cf <= 5; cf++)\n            {\n                double sp = ChromaSpreadFor(cf);\n                if (sp >= 0) { ok++; if (sp > best) { best = sp; bestCf = cf; } }\n            }\n            if (ok == 0)\n            {\n                ChosenColorFormat = 0; ChosenChromaSpread = -1;\n                ColorFormatVerdict = \"every color_format failed - capture is wedged (reboot needed)\";\n            }\n            else if (best > 8.0)\n            {\n                ChosenColorFormat = bestCf; ChosenChromaSpread = best;\n                ColorFormatVerdict = \"color_format=\" + bestCf + \" gives real chroma (spread \" +\n                                     Math.Round(best, 2) + \") - USING IT\";\n            }\n            else\n            {\n                ChosenColorFormat = 0; ChosenChromaSpread = best;\n                ColorFormatVerdict = \"flat for EVERY value (best \" + Math.Round(best, 2) +\n                                     \" <= 8): color_format is not the gate, the plane carries no usable chroma\";\n            }\n            Marshal.WriteInt32(_param, OffColorFormat, ChosenColorFormat);\n        }\n\n        /// <summary>One frame. NO file, NO encoder, NO decoder: the library writes the video plane\n        /// straight into buffers this process owns and the planes are handed over RAW (the RGBA\n        /// conversion this once did was removed - it cost ~115 ms/frame to produce 73 numbers).\n        /// Rc is 0 on success; -1 is \"not ready\" and is NOT an error.\n        ///\n        /// NOTE: the returned Y/C reference these class's STATIC buffers, so a caller must consume\n        /// them before the next Capture(). The render loop does (it reads them in the same\n        /// iteration). Holding a result across a capture would observe mutating data.</summary>\n        public static VideoPlaneResult Capture()\n        {\n            // Single diagnostic using the upstream default format.\n            var r = new VideoPlaneResult();\n            if (_call == null) { r.Rc = -1; r.Error = \"not initialised\"; return r; }\n\n            var sw = System.Diagnostics.Stopwatch.StartNew();\n            try\n            {\n                r.Rc = _call(ReqW, ReqH, _param);\n            }\n            catch (Exception e)\n            {\n                r.Rc = -1;\n                r.Error = \"native: \" + e.GetType().Name + \": \" + e.Message;\n                return r;\n            }\n\n            try\n            {\n                r.RetWidth = Marshal.ReadInt32(_param, OffRetWidth);\n                r.RetHeight = Marshal.ReadInt32(_param, OffRetHeight);\n                r.Interlaced = Marshal.ReadInt32(_param, OffInterlaced);\n                r.YPitch = Marshal.ReadInt32(_param, OffYPitch);\n                r.CPitch = Marshal.ReadInt32(_param, OffCPitch);\n            }\n            catch { /* param readback only: a failure here leaves the fields 0 and the app still runs */ }\n\n            if (r.Rc != 0) { sw.Stop(); r.CaptureMs = sw.Elapsed.TotalMilliseconds; return r; }\n\n            try\n            {\n                // Report what the library ACTUALLY produced, falling back to the request. The zone\n                // layout is built from these, so a size change is picked up automatically.\n                int aw = Marshal.ReadInt32(_param, OffRetWidth);\n                int ah = Marshal.ReadInt32(_param, OffRetHeight);\n                r.W = (aw > 0 ? aw : ReqW);\n                r.H = (ah > 0 ? ah : ReqH);\n                // ABI SANITY CLAMP. If a firmware upgrade changes the param layout these fields could\n                // come back as anything. Clamp rather than trust: an out-of-range width would otherwise\n                // shear every zone read. Extraction also bounds-checks against the buffer, so a bad\n                // value degrades rather than corrupting memory.\n                bool abiOdd = false;\n                if (r.W < 64 || r.W > PlaneW) { abiOdd = true; r.W = ReqW; }\n                if (r.H < 64 || r.H > PlaneH) { abiOdd = true; r.H = ReqH; }\n                if (abiOdd && !_abiWarned)\n                {\n                    _abiWarned = true;\n                    r.Error = \"ABI: unexpected returned dims \" + aw + \"x\" + ah + \" - using \" + r.W + \"x\" + r.H;\n                }\n                // Stride: the reported pitch when it is sane, else assume pitch == width. Only\n                // reported before - if the pitch ever differs, reading rows at `width` would shear\n                // the picture.\n                int yp = Marshal.ReadInt32(_param, OffYPitch);\n                int cp = Marshal.ReadInt32(_param, OffCPitch);\n                r.YStride = (yp >= r.W && yp <= PlaneW) ? yp : r.W;\n                r.CStride = (cp >= r.W && cp <= PlaneW) ? cp : r.W;\n                // The capture thread samples the owned native buffers before the next call.\n                r.Y = _y; r.C = _c;\n            }\n            catch (Exception e)\n            {\n                r.Error = \"plane copy: \" + e.GetType().Name + \": \" + e.Message;\n            }\n\n            sw.Stop();\n            r.CaptureMs = sw.Elapsed.TotalMilliseconds;\n            return r;\n        }\n\n        static int[] _hist;\n\n        /// <summary>Median luma of the frame, as a scene-brightness statistic.\n        ///\n        /// Shape follows the established cheap auto-exposure form: ONE O(samples) pass of histogram\n        /// increments (here 64 bins, which Unreal uses and Narkowicz notes is enough to cover a wide\n        /// range) followed by a 64-entry scan - NO SORT, no second full-frame pass. Samples are taken\n        /// with a stride, so ~3.6k of the 518k pixels are read (~0.02 ms), against a 6.4 ms zone budget.\n        ///\n        /// The MEDIAN rather than the mean: the published weakness of a mean statistic is that small\n        /// bright areas (specular highlights, a lamp in frame) bias it badly, and the established fix is\n        /// percentile filtering (Unreal Low/High Percent, Unity HDRP discarding outliers by percentile).\n        /// The median is the most robust single percentile and is what a scene-brightness estimate wants.</summary>\n        public static int MedianLuma(byte[] y, int w, int h)\n        {\n            if (y == null || w <= 0 || h <= 0) return 0;\n            if (_hist == null) _hist = new int[64];\n            for (int i = 0; i < 64; i++) _hist[i] = 0;\n\n            int n = 0;\n            for (int row = 0; row < h; row += 12)\n            {\n                int b = row * w;\n                for (int x = 0; x < w; x += 12)\n                {\n                    int idx = b + x;\n                    if (idx >= y.Length) break;\n                    _hist[y[idx] >> 2]++;          // 256 codes -> 64 bins\n                    n++;\n                }\n            }\n            if (n == 0) return 0;\n            int half = n / 2, acc = 0;\n            for (int i = 0; i < 64; i++)\n            {\n                acc += _hist[i];\n                if (acc >= half) return (i << 2) + 2;    // bin centre\n            }\n            return 255;\n        }\n\n        /// <summary>Absolute luminance (nits) of a PQ code, for reporting the scene's real brightness.</summary>\n        public static double PqNits(int code)\n        {\n            const double m1 = 2610.0 / 16384.0;\n            const double m2 = 2523.0 / 4096.0 * 128.0;\n            const double c1 = 3424.0 / 4096.0;\n            const double c2 = 2413.0 / 4096.0 * 32.0;\n            const double c3 = 2392.0 / 4096.0 * 32.0;\n            double N = (code < 0 ? 0 : (code > 255 ? 255 : code)) / 255.0;\n            double Nm = Math.Pow(N, 1.0 / m2);\n            double num = Nm - c1; if (num < 0.0) num = 0.0;\n            double den = c2 - c3 * Nm;\n            return den > 1e-9 ? 10000.0 * Math.Pow(num / den, 1.0 / m1) : 0.0;\n        }\n\n        /// <summary>PQ (SMPTE ST 2084) -> SDR, using the BT.1886 display gamma 2.4 and referencing\n        /// 203 nits as diffuse white (the HDR convention for \"graphics white\").\n        ///\n        /// WHY THIS EXISTS: the captured plane carries PQ-encoded HDR, not SDR. Measured on two\n        /// unrelated contents the plane's luma topped out at 146-148, and 148.1/255 is exactly the PQ\n        /// code for 203 nits - a transfer-function ceiling, not scene content. Decoding PQ as BT.601\n        /// limited-range threw away the entire upper half of the signal (code 148 came out as 154\n        /// instead of 255), which is exactly what \"washed out, nothing like the screen\" looks like.</summary>\n        /// <summary>Reference luminance mapped to full scale. 203 nits is the HDR convention for\n        /// diffuse white, which is why it is the default. Content varies ABOVE this (highlights run\n        /// 203-4000 nits), and anything over the reference CLIPS - which does not merely lose detail,\n        /// it pins all three channels to 255 and a bright coloured zone renders as WHITE. Raise it for\n        /// very bright films (at the cost of a dimmer picture; raise `gamma` to compensate), lower it\n        /// for dim ones. Live-tunable so the choice is per-content rather than a guess.</summary>\n        public static double HdrPeakNits = 203.0;\n\n        static bool _abiWarned;\n\n        static byte[] _pqTable;\n        static double _pqTablePeak = -1.0;\n\n        static byte[] PqToSdr()\n        {\n            if (_pqTable != null && _pqTablePeak == HdrPeakNits) return _pqTable;\n            _pqTable = BuildPqToSdrTable();\n            _pqTablePeak = HdrPeakNits;\n            return _pqTable;\n        }\n\n        static byte[] BuildPqToSdrTable()\n        {\n            const double m1 = 2610.0 / 16384.0;\n            const double m2 = 2523.0 / 4096.0 * 128.0;\n            const double c1 = 3424.0 / 4096.0;\n            const double c2 = 2413.0 / 4096.0 * 32.0;\n            const double c3 = 2392.0 / 4096.0 * 32.0;\n            double refNits = HdrPeakNits <= 0.0 ? 203.0 : HdrPeakNits;\n            var t = new byte[256];\n            for (int code = 0; code < 256; code++)\n            {\n                double N = code / 255.0;\n                double Nm = Math.Pow(N, 1.0 / m2);\n                double num = Nm - c1; if (num < 0.0) num = 0.0;\n                double den = c2 - c3 * Nm;\n                double nits = den > 1e-9 ? 10000.0 * Math.Pow(num / den, 1.0 / m1) : 0.0;\n                double x = nits / refNits;\n                // Above the 203-nit reference we clip. Further highlight tone-mapping is taste and\n                // belongs downstream, not inside the transfer function.\n                double outp = x <= 0.0 ? 0.0 : 255.0 * Math.Pow(x, 1.0 / 2.4);\n                if (outp > 255.0) outp = 255.0;\n                t[code] = (byte)(outp + 0.5);\n            }\n            return t;\n        }\n\n        static int Clamp255(double x)\n        {\n            if (x <= 0.0) return 0;\n            if (x >= 255.0) return 255;\n            return (int)(x + 0.5);\n        }\n\n        /// <summary>BT.601 limited-range YUV -> RGB for ONE already-averaged colour. Integer maths,\n        /// no toolkit. Chroma is EXPANDED about neutral by <paramref name=\"saturation\"/> first —\n        /// doing it here (in chroma space, once per zone) is what fights the desaturation that\n        /// per-channel averaging causes across a mixed zone. Per-channel white balance multiplies\n        /// the result: that is the only place the strip's own colour calibration can be corrected.\n        /// </summary>\n        public static void YuvToRgb(int Y, int U, int V, double saturation,\n                                    double kr, double kg, double kb, bool hdr, bool gamut709,\n                                    out byte rOut, out byte gOut, out byte bOut)\n        {\n            // Clamp to >= 0 rather than forcing 1.0: `sat=0` is a legal control value (the parser\n            // accepts 0..4) and means \"no chroma\", but forcing it to 1.0 made the setting silently do\n            // nothing. Negative would INVERT the chroma axes, which is never intended.\n            if (saturation < 0) saturation = 0;\n            double u = 128.0 + (U - 128.0) * saturation;\n            double v = 128.0 + (V - 128.0) * saturation;\n\n            int R, G, B;\n            if (hdr)\n            {\n                // HDR path: BT.2020 non-constant-luminance, FULL range, matrixed in the PQ CODE domain.\n                double cb = u - 128.0, cr = v - 128.0;\n                int R0 = Clamp255(Y + 1.4746 * cr);\n                int G0 = Clamp255(Y - 0.164553 * cb - 0.571353 * cr);\n                int B0 = Clamp255(Y + 1.8814 * cb);\n\n                // TONE-MAP THE LUMINANCE, SCALE RGB BY THE SAME FACTOR. NOT per channel.\n                //\n                // A convex transfer applied independently to R, G and B WIDENS the gaps between them,\n                // which INVENTS chroma. Measured on real content: +18.4% mean saturation versus this\n                // method (0.455 vs 0.384), and the error is worst exactly where it matters - the most\n                // saturated zones. A warm orange [131,80,40] became [113,85,56]: red pushed, blue\n                // suppressed, i.e. garish instead of authentic. This is the classic \"per-channel tone\n                // mapping oversaturates\" artifact.\n                //\n                // Scaling every channel by one factor derived from the LUMA keeps hue and chromaticity\n                // intact while still applying the whole PQ->SDR range compression, so the picture keeps\n                // its contrast and punch without the invented colour.\n                double L0 = 0.2627 * R0 + 0.6780 * G0 + 0.0593 * B0;   // BT.2020 luma coefficients\n                byte[] T = PqToSdr();\n                if (L0 <= 0.5)\n                {\n                    int nn = T[Clamp255(L0)];      // neutral: nothing to preserve\n                    R = nn; G = nn; B = nn;\n                }\n                else\n                {\n                    double k = T[Clamp255(L0)] / L0;\n                    R = Clamp255(R0 * k);\n                    G = Clamp255(G0 * k);\n                    B = Clamp255(B0 * k);\n                }\n\n                if (gamut709) ApplyGamut709(ref R, ref G, ref B);\n            }\n            else\n            {\n                int yy = Y - 16; if (yy < 0) yy = 0;\n                int uu = (int)Math.Round(u) - 128;\n                int vv = (int)Math.Round(v) - 128;\n\n                R = (298 * yy + 409 * vv + 128) >> 8;\n                G = (298 * yy - 100 * uu - 208 * vv + 128) >> 8;\n                B = (298 * yy + 516 * uu + 128) >> 8;\n            }\n\n            R = (int)Math.Round(R * kr);\n            G = (int)Math.Round(G * kg);\n            B = (int)Math.Round(B * kb);\n\n            if (R < 0) R = 0; else if (R > 255) R = 255;\n            if (G < 0) G = 0; else if (G > 255) G = 255;\n            if (B < 0) B = 0; else if (B > 255) B = 255;\n            rOut = (byte)R; gOut = (byte)G; bOut = (byte)B;\n        }\n\n        /// <summary>BT.2020 primaries -> BT.709 primaries, in LINEAR light.\n        ///\n        /// HDR content is mastered in BT.2020, whose primaries are WIDER; feeding those triples to a\n        /// 709/sRGB strip renders the same numbers as a LESS saturated colour. Measured +39% chroma\n        /// spread on a real frame once converted. The matrix belongs in LINEAR light, hence the\n        /// decode/re-encode around it.\n        ///\n        /// Extracted as its own method so the HDR path can decode per PIXEL (unbiased) and then apply\n        /// the gamut to the zone mean, rather than being forced to do everything per pixel.</summary>\n        public static void ApplyGamut709(ref int R, ref int G, ref int B)\n        {\n            double rl = Math.Pow(R / 255.0, 2.4);\n            double gl = Math.Pow(G / 255.0, 2.4);\n            double bl = Math.Pow(B / 255.0, 2.4);\n            double r7 = 1.6605 * rl - 0.5876 * gl - 0.0728 * bl;\n            double g7 = -0.1246 * rl + 1.1329 * gl - 0.0083 * bl;\n            double b7 = -0.0182 * rl - 0.1006 * gl + 1.1187 * bl;\n\n            // SOFT GAMUT MAP. Widening into 709 pushes saturated BT.2020 colours OUTSIDE the 709 gamut,\n            // i.e. negative linear channels. Clamping those to zero CRUSHES them (measured 11-34% of\n            // zones losing a channel to black = lost shadow detail). Desaturate toward the colour's own\n            // luminance by the SMALLEST amount that brings it back in gamut: hue survives, nothing is\n            // crushed.\n            double lum = 0.2126 * r7 + 0.7152 * g7 + 0.0722 * b7;\n            double t = 0.0;\n            double dc;\n            dc = r7; if (dc < 0.0) { double need = (lum - dc) > 1e-9 ? (-dc) / (lum - dc) : 1.0; if (need > t) t = need; }\n            dc = g7; if (dc < 0.0) { double need = (lum - dc) > 1e-9 ? (-dc) / (lum - dc) : 1.0; if (need > t) t = need; }\n            dc = b7; if (dc < 0.0) { double need = (lum - dc) > 1e-9 ? (-dc) / (lum - dc) : 1.0; if (need > t) t = need; }\n            dc = r7; if (dc > 1.0) { double need = (lum - dc) < -1e-9 ? (dc - 1.0) / (dc - lum) : 1.0; if (need > t) t = need; }\n            dc = g7; if (dc > 1.0) { double need = (lum - dc) < -1e-9 ? (dc - 1.0) / (dc - lum) : 1.0; if (need > t) t = need; }\n            dc = b7; if (dc > 1.0) { double need = (lum - dc) < -1e-9 ? (dc - 1.0) / (dc - lum) : 1.0; if (need > t) t = need; }\n            if (t > 1.0) t = 1.0;\n            r7 = r7 + (lum - r7) * t;\n            g7 = g7 + (lum - g7) * t;\n            b7 = b7 + (lum - b7) * t;\n            if (r7 < 0.0) r7 = 0.0; else if (r7 > 1.0) r7 = 1.0;\n            if (g7 < 0.0) g7 = 0.0; else if (g7 > 1.0) g7 = 1.0;\n            if (b7 < 0.0) b7 = 0.0; else if (b7 > 1.0) b7 = 1.0;\n            R = Clamp255(255.0 * Math.Pow(r7, 1.0 / 2.4));\n            G = Clamp255(255.0 * Math.Pow(g7, 1.0 / 2.4));\n            B = Clamp255(255.0 * Math.Pow(b7, 1.0 / 2.4));\n        }\n\n        /// <summary>Find the ACTIVE picture area vertically, i.e. strip off letterbox bars.\n        ///\n        /// Why this matters more than any tuning knob: on a 2.39:1 film in a 16:9 frame the bars are\n        /// ~69 px tall while our border bands are only 43 px deep - so the top 23 and bottom 24 zones\n        /// sample PURE BLACK, 47 of 73 zones, and no amount of gain or saturation can recover them.\n        ///\n        /// A row counts as bar if >=90% of its sampled pixels are below `thr`. That \"nearly all dark\"\n        /// test is deliberate: a merely dark scene has variation, bars are uniform near-zero. Looking\n        /// for uniformity rather than darkness is what stops a night scene being mistaken for bars.\n        ///\n        /// Bars are capped at a quarter of the height each, so a fully black screen cannot be\n        /// misread as \"entirely bar\" and collapse the picture area to nothing.\n        /// </summary>\n        public const int MinBarPx = 12;\n\n        /// <summary>Column test for PILLARBOX bars (left/right), the horizontal mirror of RowIsBar.\n        ///\n        /// Stricter than the row test on purpose: it requires EVERY sampled pixel to be dark, not 90%\n        /// of them. The looser row version is what produced false positives that cropped real picture\n        /// on dark rows, so the column test demands uniformity AND darkness. A genuinely black bar is\n        /// flat at the black level (measured: a whole bar column reads a constant code 16), whereas\n        /// even a dark night scene carries some structure that exceeds the threshold.</summary>\n        static bool ColIsBar(byte[] y, int col, int w, int h, int step, int thr)\n        {\n            int dark = 0, cnt = 0;\n            for (int row = 0; row < h; row += step)   // NB: not `y` - that is the plane parameter\n            {\n                int idx = row * w + col;\n                if (idx < 0 || idx >= y.Length) return false;\n                if (y[idx] < thr) dark++;\n                cnt++;\n            }\n            return cnt > 0 && dark == cnt;          // ALL sampled pixels dark\n        }\n\n        /// <summary>Find the active picture area HORIZONTALLY (strip pillarbox bars). Mirrors\n        /// DetectActiveArea with the same guards: bars capped at a quarter of the width each, slivers\n        /// below MinBarPx ignored, and never collapse the picture below a third of the frame.</summary>\n        public static void DetectActiveAreaX(byte[] y, int w, int h, int thr, out int xLeft, out int xRight)\n        {\n            int step = 8;\n            int maxBar = w / 4;\n            xLeft = 0; xRight = w;\n\n            int l = 0;\n            while (l < maxBar && ColIsBar(y, l, w, h, step, thr)) l++;\n            xLeft = (l >= maxBar) ? 0 : l;\n\n            int r = w - 1, run = 0;\n            while (run < maxBar && r > 0 && ColIsBar(y, r, w, h, step, thr)) { r--; run++; }\n            xRight = (run >= maxBar) ? w : (r + 1);\n\n            if (xRight - xLeft < w / 3) { xLeft = 0; xRight = w; }   // never collapse the picture\n            if (xLeft < MinBarPx) xLeft = 0;\n            if (w - xRight < MinBarPx) xRight = w;\n        }\n\n        public static void DetectActiveArea(byte[] y, int w, int h, int thr, out int yTop, out int yBottom)\n        {\n            int step = 8;\n            int maxBar = h / 4;\n            yTop = 0; yBottom = h;\n\n            int t = 0;\n            while (t < maxBar && RowIsBar(y, t, w, step, thr)) t++;\n            yTop = (t >= maxBar) ? 0 : t;\n\n            int b = h - 1;\n            int run = 0;\n            while (run < maxBar && b > 0 && RowIsBar(y, b, w, step, thr)) { b--; run++; }\n            yBottom = (run >= maxBar) ? h : (b + 1);\n\n            if (yBottom - yTop < h / 3) { yTop = 0; yBottom = h; }   // sanity: never collapse the picture\n\n            // Tiny \"bars\" are noise, not letterboxing. A 2-3 px sliver usually means a dark row at the\n            // very top/bottom of the picture, and cropping to it only shifts the sampling window for no\n            // benefit - which shows up as the strip twitching.\n            if (yTop < MinBarPx) yTop = 0;\n            if (h - yBottom < MinBarPx) yBottom = h;\n        }\n\n        static bool RowIsBar(byte[] y, int row, int w, int step, int thr)\n        {\n            int baseIdx = row * w;\n            if (baseIdx < 0 || baseIdx + w > y.Length) return false;\n            // EVERY sampled pixel must be below the threshold - not \"90% of them\".\n            //\n            // The 90% rule is what made this crop REAL PICTURE: on a dark film (row means 21-26) a\n            // scene would satisfy it while genuinely containing picture, the crop would follow the\n            // scene's brightness (measured drifting 50 -> 71 rows in 7 s) and the ambience geometry\n            // lurched with it. A real letterbox bar is FLAT at the black level, so demanding flatness\n            // costs nothing for true bars and rejects dark-but-structured picture.\n            int dark = 0, cnt = 0;\n            for (int x = 0; x < w; x += step)\n            {\n                if (y[baseIdx + x] < thr) dark++;\n                cnt++;\n            }\n            return cnt > 0 && dark == cnt;\n        }\n\n        public static void Shutdown()\n        {\n            foreach (IntPtr p in new IntPtr[] { _param, _bufY, _bufC })\n                if (p != IntPtr.Zero) { try { Marshal.FreeHGlobal(p); } catch { } }\n            _param = _bufY = _bufC = IntPtr.Zero;\n            _call = null;\n        }\n    }\n}\n","controls.json":"[\n {\n  \"group\": \"Lighting\",\n  \"key\": \"Lighting\",\n  \"label\": \"Output mode\",\n  \"default\": \"screen\",\n  \"options\": {\n   \"screen\": \"Screen sync\",\n   \"audio\": \"Audio sync\",\n   \"solid\": \"Solid\",\n   \"twinkle\": \"Twinkle\",\n   \"wave\": \"Rolling wave\",\n   \"spark\": \"Fireflies\",\n   \"breathe\": \"Breathe\",\n   \"chase\": \"Comet trail\"\n  },\n  \"hint\": \"Audio sync uses the WLED controller\\u2019s audio input or audio-sync receiver. TV strip preview and side masking apply to TV-generated output.\"\n },\n {\n  \"group\": \"Lighting\",\n  \"key\": \"Tint\",\n  \"label\": \"Manual color\",\n  \"type\": \"color\",\n  \"default\": \"#ff8844\"\n },\n {\n  \"group\": \"Lighting\",\n  \"key\": \"Period\",\n  \"label\": \"Effect cycle\",\n  \"default\": 4,\n  \"min\": 1,\n  \"max\": 20,\n  \"unit\": \"s\"\n },\n {\n  \"group\": \"WLED target\",\n  \"key\": \"Protocol\",\n  \"label\": \"Receiver protocol\",\n  \"default\": \"ddp\",\n  \"options\": {\n   \"ddp\": \"DDP \\u00b7 RGB\",\n   \"dnrgb\": \"WLED UDP \\u00b7 DNRGB\"\n  }\n },\n {\n  \"group\": \"Color\",\n  \"key\": \"Hdr\",\n  \"label\": \"HDR decoding\",\n  \"default\": \"auto\",\n  \"options\": {\n   \"auto\": \"Follow TV\",\n   \"on\": \"Force HDR10\",\n   \"off\": \"Force SDR\"\n  },\n  \"hint\": \"Applies to full-picture capture. The fallback already supplies RGB.\"\n },\n {\n  \"group\": \"Color\",\n  \"key\": \"Saturation\",\n  \"label\": \"Saturation\",\n  \"default\": 100,\n  \"min\": 0,\n  \"max\": 200,\n  \"unit\": \"%\"\n },\n {\n  \"group\": \"Color\",\n  \"key\": \"Brightness\",\n  \"label\": \"LED brightness\",\n  \"default\": 100,\n  \"min\": 0,\n  \"max\": 100,\n  \"unit\": \"%\"\n },\n {\n  \"group\": \"Color\",\n  \"key\": \"Gamma\",\n  \"label\": \"Output gamma\",\n  \"default\": 100,\n  \"min\": 50,\n  \"max\": 250,\n  \"unit\": \"\\u00d7100\",\n  \"hint\": \"100 is neutral. Higher values darken midtones.\"\n },\n {\n  \"group\": \"Color\",\n  \"key\": \"Reference\",\n  \"label\": \"HDR reference white\",\n  \"default\": 203,\n  \"min\": 100,\n  \"max\": 1000,\n  \"unit\": \"nits\",\n  \"hint\": \"Higher values preserve more highlight detail.\"\n },\n {\n  \"group\": \"Color\",\n  \"key\": \"Black\",\n  \"label\": \"Black cutoff\",\n  \"default\": 0,\n  \"min\": 0,\n  \"max\": 40,\n  \"unit\": \"/255\",\n  \"hint\": \"Switch a zone off when all three channels are at or below this level.\"\n },\n {\n  \"group\": \"White balance\",\n  \"key\": \"Red\",\n  \"label\": \"Red gain\",\n  \"default\": 100,\n  \"min\": 0,\n  \"max\": 150,\n  \"unit\": \"%\"\n },\n {\n  \"group\": \"White balance\",\n  \"key\": \"Green\",\n  \"label\": \"Green gain\",\n  \"default\": 100,\n  \"min\": 0,\n  \"max\": 150,\n  \"unit\": \"%\"\n },\n {\n  \"group\": \"White balance\",\n  \"key\": \"Blue\",\n  \"label\": \"Blue gain\",\n  \"default\": 100,\n  \"min\": 0,\n  \"max\": 150,\n  \"unit\": \"%\"\n },\n {\n  \"group\": \"Motion\",\n  \"key\": \"Smooth\",\n  \"label\": \"Smoothing time\",\n  \"default\": 125,\n  \"min\": 0,\n  \"max\": 500,\n  \"unit\": \"ms\"\n },\n {\n  \"group\": \"Motion\",\n  \"key\": \"CaptureHz\",\n  \"label\": \"Full-picture capture target\",\n  \"default\": 60,\n  \"min\": 5,\n  \"max\": 60,\n  \"unit\": \"FPS\"\n },\n {\n  \"group\": \"Motion\",\n  \"key\": \"SendHz\",\n  \"label\": \"WLED stream target\",\n  \"default\": 62,\n  \"min\": 5,\n  \"max\": 62,\n  \"unit\": \"FPS\",\n  \"hint\": \"Controls the TV sender. Actual strip refresh depends on WLED.\"\n },\n {\n  \"group\": \"Sampling\",\n  \"key\": \"Source\",\n  \"label\": \"Capture mode\",\n  \"default\": \"auto\",\n  \"options\": {\n   \"auto\": \"Full picture with fallback\",\n   \"sampler\": \"TV color sampler only\"\n  }\n },\n {\n  \"group\": \"Sampling\",\n  \"key\": \"Fallback\",\n  \"label\": \"Fallback zones\",\n  \"default\": 16,\n  \"choices\": [\n   4,\n   8,\n   16\n  ],\n  \"hint\": \"Fewer zones refresh each sampled position more often.\"\n },\n {\n  \"group\": \"Sampling\",\n  \"key\": \"Bars\",\n  \"label\": \"Black-bar detection\",\n  \"default\": \"both\",\n  \"options\": {\n   \"both\": \"All borders\",\n   \"rows\": \"Top and bottom\",\n   \"columns\": \"Left and right\",\n   \"off\": \"Off\"\n  }\n },\n {\n  \"group\": \"Sampling\",\n  \"key\": \"SampleMode\",\n  \"label\": \"Zone color sampling\",\n  \"default\": \"average\",\n  \"options\": {\n   \"edge\": \"Outer edge\",\n   \"average\": \"Four-point average\",\n   \"median\": \"Median\",\n   \"inner\": \"Inner edge\",\n   \"weighted\": \"Edge-weighted\",\n   \"whole\": \"Whole-strip average\",\n   \"accent\": \"Color accent\",\n   \"highlight\": \"Highlight\",\n   \"side\": \"One color per side\"\n  },\n  \"hint\": \"Accent selects the most colorful depth sample. Highlight selects the brightest. In fallback, Accent and Highlight pick one measured spot per side. One color per side averages the edge in either capture mode.\"\n },\n {\n  \"group\": \"Sampling\",\n  \"key\": \"Depth\",\n  \"label\": \"Edge sampling depth\",\n  \"default\": 16,\n  \"min\": 4,\n  \"max\": 48,\n  \"unit\": \"px\",\n  \"hint\": \"Four samples per LED, spread inward from the picture edge.\"\n },\n {\n  \"group\": \"WLED target\",\n  \"key\": \"Wled\",\n  \"label\": \"WLED address\",\n  \"default\": \"127.0.0.1\",\n  \"type\": \"ipv4\",\n  \"hint\": \"Enter the WLED controller IPv4 address.\"\n },\n {\n  \"group\": \"WLED target\",\n  \"key\": \"Offset\",\n  \"label\": \"LED start offset\",\n  \"default\": 0,\n  \"min\": 0,\n  \"max\": 4095,\n  \"unit\": \"LEDs\"\n },\n {\n  \"group\": \"WLED target\",\n  \"key\": \"Direction\",\n  \"label\": \"Strip order\",\n  \"default\": \"normal\",\n  \"options\": {\n   \"normal\": \"Clockwise\",\n   \"reverse\": \"Counterclockwise\"\n  }\n },\n {\n  \"group\": \"WLED target\",\n  \"key\": \"Leds\",\n  \"label\": \"LEDs on controller\",\n  \"default\": 538,\n  \"min\": 1,\n  \"max\": 4096,\n  \"unit\": \"LEDs\",\n  \"hint\": \"Number of addressable RGB pixels on the receiver.\",\n  \"hidden\": true\n },\n {\n  \"group\": \"Sampling\",\n  \"key\": \"ZonesMode\",\n  \"label\": \"Full-picture zone count\",\n  \"default\": \"match\",\n  \"options\": {\n   \"match\": \"Match WLED LEDs\",\n   \"custom\": \"Choose custom count\"\n  },\n  \"hint\": \"Match uses up to 538 sampled zones, distributed over the strip.\"\n },\n {\n  \"group\": \"Sampling\",\n  \"key\": \"Zones\",\n  \"label\": \"Custom full-picture zones\",\n  \"default\": 512,\n  \"choices\": [\n   4,\n   8,\n   16,\n   32,\n   64,\n   128,\n   256,\n   512\n  ],\n  \"hint\": \"Used when full-picture zone count is set to custom.\"\n },\n {\n  \"group\": \"WLED target\",\n  \"key\": \"StartCorner\",\n  \"label\": \"Strip start corner\",\n  \"default\": \"bottom-left\",\n  \"options\": {\n   \"top-left\": \"Top left\",\n   \"top-right\": \"Top right\",\n   \"bottom-right\": \"Bottom right\",\n   \"bottom-left\": \"Bottom left\"\n  }\n },\n {\n  \"group\": \"Strip sides\",\n  \"key\": \"Top\",\n  \"label\": \"Top edge\",\n  \"type\": \"toggle\",\n  \"default\": true\n },\n {\n  \"group\": \"Strip sides\",\n  \"key\": \"TopCount\",\n  \"label\": \"Top LED count\",\n  \"default\": 172,\n  \"min\": 0,\n  \"max\": 4096,\n  \"unit\": \"LEDs\",\n  \"type\": \"count\"\n },\n {\n  \"group\": \"Strip sides\",\n  \"key\": \"Right\",\n  \"label\": \"Right edge\",\n  \"type\": \"toggle\",\n  \"default\": true\n },\n {\n  \"group\": \"Strip sides\",\n  \"key\": \"RightCount\",\n  \"label\": \"Right LED count\",\n  \"default\": 97,\n  \"min\": 0,\n  \"max\": 4096,\n  \"unit\": \"LEDs\",\n  \"type\": \"count\"\n },\n {\n  \"group\": \"Strip sides\",\n  \"key\": \"Bottom\",\n  \"label\": \"Bottom edge\",\n  \"type\": \"toggle\",\n  \"default\": true\n },\n {\n  \"group\": \"Strip sides\",\n  \"key\": \"BottomCount\",\n  \"label\": \"Bottom LED count\",\n  \"default\": 172,\n  \"min\": 0,\n  \"max\": 4096,\n  \"unit\": \"LEDs\",\n  \"type\": \"count\"\n },\n {\n  \"group\": \"Strip sides\",\n  \"key\": \"Left\",\n  \"label\": \"Left edge\",\n  \"type\": \"toggle\",\n  \"default\": true\n },\n {\n  \"group\": \"Strip sides\",\n  \"key\": \"LeftCount\",\n  \"label\": \"Left LED count\",\n  \"default\": 97,\n  \"min\": 0,\n  \"max\": 4096,\n  \"unit\": \"LEDs\",\n  \"type\": \"count\"\n }\n]\n","discover.js":"'use strict';\nvar dgram = require('dgram');\nvar service = '_wled._tcp.local';\n\n// DNS names can refer back to earlier labels in the same packet.\nfunction nameAt(packet, offset) {\n    var labels = [], end, length;\n    for (var hops = 0; hops < 64 && offset < packet.length; hops++) {\n        length = packet[offset++];\n        if (!length) return {name:labels.join('.'), end:end || offset};\n        if ((length & 192) === 192 && offset < packet.length) {\n            end = end || offset + 1;\n            offset = ((length & 63) << 8) | packet[offset];\n        } else {\n            if (length > 63 || offset + length > packet.length) break;\n            labels.push(packet.toString('utf8', offset, offset + length));\n            offset += length;\n        }\n    }\n    throw Error('Invalid DNS name');\n}\n\nfunction instance(packet) {\n    if (packet.length < 12 || !(packet[2] & 128)) return;\n    var offset = 12, i;\n    for (i = 0; i < packet.readUInt16BE(4); i++) offset = nameAt(packet, offset).end + 4;\n    while (offset < packet.length) {\n        var owner = nameAt(packet, offset);\n        var type = packet.readUInt16BE(owner.end);\n        var size = packet.readUInt16BE(owner.end + 8);\n        offset = owner.end + 10;\n        if (offset + size > packet.length) return;\n        if (type === 12 && owner.name.toLowerCase() === service && packet.readUInt32BE(owner.end + 4)) {\n            var target = nameAt(packet, offset).name;\n            if (target.toLowerCase().slice(-service.length-1) === '.' + service)\n                return target.slice(0, -service.length-1);\n        }\n        offset += size;\n    }\n}\n\nmodule.exports = function discover() {\n    return new Promise(function(resolve, reject) {\n        var socket = dgram.createSocket('udp4'), devices = {}, done = false;\n        var query = new Buffer('000000000001000000000000055f776c6564045f746370056c6f63616c00000c0001', 'hex');\n        function finish(error) {\n            if (done) return;\n            done = true;\n            clearTimeout(timer);\n            try { socket.close(); } catch (_) {}\n            if (error) reject(error);\n            else resolve(Object.keys(devices).sort().map(function(address) {\n                return {address:address, name:devices[address]};\n            }));\n        }\n        var timer = setTimeout(finish, 3000);\n        socket.on('error', finish);\n        socket.on('message', function(packet, peer) {\n            if (peer.port !== 5353) return;\n            try {\n                var name = instance(packet);\n                if (name) devices[peer.address] = name;\n            } catch (_) { /* Ignore malformed advertisements. */ }\n        });\n        socket.send(query, 0, query.length, 5353, '224.0.0.251');\n    });\n};\n","index.js":"'use strict';\nmodule.exports = function(ctx) {\n    var fs = require('fs'), path = require('path'), detail = {}, timer, busy = false, active = false, captureEnabled = true;\n    var unit = 'vetro-ambilight-studio.service';\n    var hdrFile = path.join(ctx.dir,'hdr-state'), recoveryFile = path.join(ctx.dir,'picture-recovery-until'), hdrTimer, readingHdr = false;\n    function readHdr() {\n        if (readingHdr || !active) return;\n        readingHdr = true;\n        ctx.execute('busctl --system call org.tizen.tv.avoc /org/tizen/tv/avoc org.tizen.tv.avoc.AvOutputControl GetHdrStatus',2000).then(function(r){\n            var m = /^[iyu]{2}\\s+([01])\\s+0\\s*$/.exec(r.stdout || '');\n            if (active && r.exit_code === 0 && m) {\n                fs.writeFileSync(hdrFile+'.tmp',m[1]);\n                fs.renameSync(hdrFile+'.tmp',hdrFile);\n            }\n        }).catch(function(){}).then(function(){readingHdr=false;});\n    }\n    function check() {\n        if (busy || !active || !captureEnabled) return;\n        busy = true;\n        var exe = path.join(ctx.dir,'Colour.exe');\n        var command = 'if ! systemctl is-active --quiet '+unit+'; then systemctl reset-failed '+unit+' 2>/dev/null; systemd-run --unit=vetro-ambilight-studio /usr/bin/dotnet '+exe+'; fi; systemctl is-active '+unit+'; cat /tmp/ambilight-studio-rate 2>/dev/null || true';\n        ctx.execute(command,8000).then(function(r){detail=r; if(!active) return ctx.execute('systemctl stop '+unit,5000);}).catch(function(e){detail={error:e.message};}).then(function(){busy=false;});\n    }\n    var settingsRoute = require(\"./settings.js\")(ctx,function(){return detail;});\n    function json(res,value,code) {\n        res.writeHead(code || 200,{'Content-Type':'application/json','Cache-Control':'no-store'});\n        res.end(JSON.stringify(value));\n    }\n    function route(req,res,sub) {\n        if (sub === \"ui\") return settingsRoute(req,res,sub);\n        if (sub !== 'capture-action' || req.method !== 'POST') return settingsRoute(req,res,sub);\n        var body='',size=0;\n        req.on('data',function(chunk){size+=chunk.length;if(size<=128)body+=chunk;});\n        req.on('end',function(){\n            try {\n                if(size>128)throw Error('Invalid capture action');\n                var action=JSON.parse(body).action;\n                if(action==='stop'){\n                    captureEnabled=false;detail={stdout:'Capture stopped',state:'stopped'};\n                    ctx.execute('systemctl stop '+unit+'; systemctl is-active '+unit+' 2>/dev/null || true',8000).then(function(){json(res,{ok:true,state:'stopped'});},function(e){json(res,{error:e.message},500);});\n                } else if(action==='start'){\n                    if(!active)throw Error('Enable the Ambilight Shard first');\n                    captureEnabled=true;\n                    var exe=path.join(ctx.dir,'Colour.exe');\n                    ctx.execute('if ! systemctl is-active --quiet '+unit+'; then systemctl reset-failed '+unit+' 2>/dev/null; systemd-run --unit='+unit+' /usr/bin/dotnet '+exe+'; fi; systemctl is-active '+unit,10000)\n                        .then(function(r){json(res,{ok:r.exit_code===0,state:r.stdout.trim()});},function(e){json(res,{error:e.message},500);});\n                } else if(action==='restart'){\n                    if(!active)throw Error('Enable the Ambilight Shard first');\n                    captureEnabled=true;\n                    fs.writeFileSync(recoveryFile+'.tmp',String(Date.now()+8000));\n                    fs.renameSync(recoveryFile+'.tmp',recoveryFile);\n                    ctx.execute('if systemctl is-active --quiet '+unit+'; then systemctl restart '+unit+'; else systemctl reset-failed '+unit+' 2>/dev/null; systemd-run --unit='+unit+' /usr/bin/dotnet '+path.join(ctx.dir,'Colour.exe')+'; fi; systemctl is-active '+unit,12000)\n                        .then(function(r){json(res,{ok:r.exit_code===0,state:r.stdout.trim(),pictureRecoveryMs:8000});},function(e){json(res,{error:e.message},500);});\n                } else throw Error('Unknown capture action');\n            } catch(e){json(res,{error:e.message},400);}\n        });\n        return true;\n    }\n    return {route:route,start:function(){\n        fs.writeFileSync(path.join(ctx.dir,'Colour.exe'),new Buffer(fs.readFileSync(path.join(__dirname,'payload.b64'),'utf8'),'base64'));\n        active=true;captureEnabled=true;readHdr();hdrTimer=setInterval(readHdr,2000);check();timer=setInterval(check,5000);\n    },stop:function(){active=false;clearInterval(timer);clearInterval(hdrTimer);ctx.execute('systemctl stop '+unit,5000).catch(function(){});},status:function(){return detail;}};\n};\n","panel.html":"<!doctype html>\n<html lang=\"en\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Ambilight Studio</title>\n<style>\n:root{color-scheme:dark;font-family:Inter,system-ui,sans-serif;background:#101017;color:#f5f2fb}\n*{box-sizing:border-box}body{margin:0}main{max-width:1000px;margin:auto;padding:clamp(18px,4vw,42px)}\nheader{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap}\nh1{font-size:clamp(32px,5vw,54px);letter-spacing:-.055em;margin:0}h2{font-size:1.05rem;margin:0 0 10px}\nsection,details{background:#1a1924;border:1px solid #383443;border-radius:16px;padding:20px;margin:14px 0}\n.capture{background:linear-gradient(125deg,#29203c,#1c1c2b);padding:24px}\n.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:20px 0}.metrics strong{font:600 1.6rem system-ui;display:block}\ncanvas{width:100%;height:38px;background:#100f17;border-radius:8px;display:block;margin:10px 0}\n.row{display:grid;grid-template-columns:minmax(140px,1fr) minmax(170px,1fr);gap:12px 26px;align-items:center;padding:14px 0}.row+.row{border-top:1px solid #35303f}\nlabel,summary{font-weight:600}summary{cursor:pointer}small,.unit,#status{color:#c0b7cf;line-height:1.45}small{display:block;margin-top:4px}\n.inputs,.actions,footer,nav{display:flex;align-items:center;gap:9px;flex-wrap:wrap}\ninput,select,button{background:#211f2c;color:inherit;border:1px solid #524861;border-radius:8px;padding:9px;font:inherit}\ninput[type=range]{min-width:50px;flex:1;accent-color:#bc9aff}input[type=number]{width:5em}select{max-width:100%}button{cursor:pointer}\nbutton.primary,nav button[aria-pressed=true]{background:#d5bcff;color:#21132e;border-color:transparent;font-weight:650}\nbutton:disabled{opacity:.5;cursor:default}footer{position:sticky;bottom:0;background:#101017f5;padding:14px 0}pre{white-space:pre-wrap;overflow-wrap:anywhere}\n@media(max-width:620px){.row{grid-template-columns:1fr}section{padding:15px}.metrics strong{font-size:1.2rem}}\n.row{padding:18px 0}.inputs:has(input[type=range]){display:grid;grid-template-columns:minmax(0,1fr) 5em auto;gap:10px}.inputs input[type=range]{width:100%;min-width:0;padding:0;margin:0;border:0}.inputs input[type=number]{width:100%}nav{margin:16px 0;gap:10px}footer{margin-top:18px}#view{margin:8px 12px}input[type=checkbox]{width:22px;height:22px;accent-color:#bc9aff}\n</style>\n<main><header><h1>Ambilight Studio</h1><p id=\"status\" role=\"status\">Connecting…</p></header>\n<section class=\"capture\"><h2>Strip output</h2><canvas id=\"strip\" width=\"768\" height=\"38\" aria-label=\"48 color samples in physical strip order\"></canvas>\n<small id=\"previewState\">Waiting for output…</small>\n<div class=\"metrics\"><div><small>Active zones</small><strong id=\"zones\">—</strong></div><div><small>Scans / sec</small><strong id=\"fps\">—</strong></div><div><small>Changes / sec</small><strong id=\"changes\">—</strong></div></div>\n<div class=\"actions\"><button type=\"button\" data-action=\"start\">Start</button><button type=\"button\" data-action=\"stop\">Stop</button><button type=\"button\" data-action=\"restart\">Restart capture</button><span id=\"captureMsg\" role=\"status\"></span></div></section>\n<details id=\"diagnosticsPanel\" hidden><summary>Capture diagnostics</summary><pre id=\"diagnostics\">Waiting for capture…</pre></details>\n<label>Settings view <select id=\"view\"><option value=\"simple\">Simple</option><option value=\"advanced\">Advanced</option></select></label><nav id=\"tabs\" aria-label=\"Settings groups\"></nav>\n<form id=\"form\"><div id=\"groups\"></div>\n<footer><button type=\"button\" class=\"primary\" id=\"apply\" disabled>Apply settings</button><button type=\"button\" id=\"defaults\" disabled>Restore defaults</button><span role=\"status\" id=\"msg\"></span></footer></form></main>\n<script>\n'use strict';\nvar fields=[], saved={}, inputs={}, pending=false;\nvar el=function(id){return document.getElementById(id)};\nfunction request(url,opts){return fetch(url,opts).then(function(r){return r.json().then(function(d){if(!r.ok)throw Error(d.error||'Request failed');return d;});});}\nfunction node(tag,parent,txt){var n=document.createElement(tag);parent.appendChild(n);if(txt!==undefined)n.textContent=txt;return n;}\nfunction values(){var d={};fields.forEach(function(f){d[f.key]=f.type==='toggle'?inputs[f.key].main.checked:f.options||f.type==='color'||f.type==='ipv4'?inputs[f.key].main.value:Number(inputs[f.key].main.value);});return d;}\nfunction change(){var v=values();var dirty=fields.some(function(f){return saved[f.key]!==v[f.key];});el('apply').disabled=!dirty||pending;el('msg').textContent=dirty?'Unsaved changes':'';}\nfunction fill(d){fields.forEach(function(f){var i=inputs[f.key];if(f.type==='toggle')i.main.checked=d[f.key];else i.main.value=d[f.key];if(i.range)i.range.value=d[f.key];});change();}\nfunction draw(data){\n fields=data.fields.filter(function(f){return !f.hidden;});saved=data.values;var sections={};\n fields.forEach(function(f){\n  var section=sections[f.group];if(!section){section=node('section',el('groups'));sections[f.group]=section;node('h2',section,f.group);\n   var tab=node('button',el('tabs'),f.group);\n   section.hidden=Object.keys(sections).length>1;\n   tab.setAttribute('aria-pressed',String(!section.hidden));\n   tab.onclick=function(){\n    Object.keys(sections).forEach(function(group){sections[group].hidden=group!==f.group;});\n    Array.prototype.forEach.call(el('tabs').children,function(t){t.setAttribute('aria-pressed',String(t===tab));});\n   };}\n  var row=node('div',section);row.className='row';var left=node('div',row),label=node('label',left,f.label);label.htmlFor=f.key;\n  if(f.hint)node('small',left,f.hint);var right=node('div',row);right.className='inputs';var i={};inputs[f.key]=i;\n  if(f.type==='count'){i.main=node('input',right);i.main.type='number';i.main.min=f.min;i.main.max=f.max;i.main.required=true;}\n  else if(f.type==='toggle'){i.main=node('input',right);i.main.type='checkbox';}\n  else if(f.type==='color'){i.main=node('input',right);i.main.type='color';}\n  else if(f.type==='ipv4'){i.main=node('input',right);i.main.type='text';i.main.inputMode='decimal';i.main.autocomplete='off';i.main.pattern='(?:25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])(?:\\\\.(?:25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])){3}';i.main.required=true;}\n  else if(f.options||f.choices){i.main=node('select',right);(f.choices||Object.keys(f.options)).forEach(function(k){var parent=i.main;\n    if(f.key==='Lighting'){\n     var label=['screen','audio','solid'].indexOf(k)>=0?'Main modes':'Effects';\n     var group=i.main.lastElementChild;\n     if(!group||group.label!==label){group=node('optgroup',i.main);group.label=label;}\n     parent=group;\n    }\n    var o=node('option',parent,f.options?f.options[k]:k);o.value=k;});}\n  else{i.range=node('input',right);i.range.type='range';i.range.setAttribute('aria-label',f.label);i.main=node('input',right);i.main.type='number';i.main.required=true;\n   [i.range,i.main].forEach(function(n){n.min=f.min;n.max=f.max;n.step=1;});i.range.oninput=function(){i.main.value=i.range.value;change();};\n   node('span',right,f.unit).className='unit';\n  }\n  if(f.key==='Wled') addDiscovery(right,i.main);\n  i.main.id=f.key;i.main.oninput=i.main.onchange=function(){if(i.range)i.range.value=i.main.value;change();};\n });\n var basic=['Lighting','Tint','Period','Wled','Brightness','Smooth'];\n function setView(){\n  var simple=el('view').value==='simple';\n  el('diagnosticsPanel').hidden=simple;\n  el('tabs').style.display=simple?'none':'';\n  fields.forEach(function(f){inputs[f.key].main.closest('.row').style.display=simple&&basic.indexOf(f.key)<0?'none':'';});\n  Object.keys(sections).forEach(function(group,index){\n   sections[group].hidden=simple?!fields.some(function(f){return f.group===group&&basic.indexOf(f.key)>=0;}):index!==0;\n   el('tabs').children[index].setAttribute('aria-pressed',String(index===0));\n  });\n  try{localStorage.setItem('studioView',el('view').value);}catch(e){}\n }\n try{if(localStorage.getItem('studioView')==='advanced')el('view').value='advanced';}catch(e){}\n el('view').onchange=setView;setView();fill(saved);el('defaults').disabled=false;\n}\nfunction addDiscovery(parent,input){\n var search=node('button',parent,'Find WLED controllers'), results=node('div',parent);\n search.type='button'; results.setAttribute('aria-live','polite');\n search.onclick=function(){\n  search.disabled=true;results.textContent='Searching the local network…';\n  request('discover',{method:'POST'}).then(function(data){\n   results.textContent=data.devices.length?'':'No controllers advertised. Enter an IPv4 address manually.';\n   data.devices.forEach(function(device){\n    var pick=node('button',results,device.name+' · '+device.address);pick.type='button';\n    pick.onclick=function(){input.value=device.address;change();results.textContent='Selected '+device.name+'. Apply settings to use it.';};\n   });\n  }).catch(function(error){results.textContent=error.message;}).then(function(){search.disabled=false;});\n };\n}\nel('defaults').onclick=function(){var d={};fields.forEach(function(f){d[f.key]=f.default;});fill(d);};\nel('apply').onclick=function(){if(pending||!el('form').reportValidity())return;var v=values(),patch={};fields.forEach(function(f){if(v[f.key]!==saved[f.key])patch[f.key]=v[f.key];});\n pending=true;el('apply').disabled=true;el('groups').style.pointerEvents='none';el('defaults').disabled=true;\n request('settings',{method:'POST',headers:{'Content-Type':'text/plain'},body:JSON.stringify(patch)}).then(function(d){pending=false;saved=d.values;fill(saved);el('msg').textContent='Settings saved';}).catch(function(e){pending=false;change();el('msg').textContent=e.message;}).then(function(){el('groups').style.pointerEvents='';el('defaults').disabled=false;});};\ndocument.querySelectorAll('[data-action]').forEach(function(button){button.onclick=function(){\n var action=button.dataset.action;document.querySelectorAll('[data-action]').forEach(function(b){b.disabled=true;});\n el('captureMsg').textContent=action==='stop'?'Stopping…':action==='start'?'Starting…':'Restarting…';\n request('capture-action',{method:'POST',headers:{'Content-Type':'text/plain'},body:JSON.stringify({action:action})})\n .then(function(result){\n  if(action==='restart'){el('captureMsg').textContent='Capture restarted';return;}\n  el('captureMsg').textContent=action==='stop'?'Capture stopped':'Capture starting';\n }).then(function(){setTimeout(live,1200);})\n .catch(function(e){el('captureMsg').textContent=e.message;})\n .then(function(){setTimeout(function(){document.querySelectorAll('[data-action]').forEach(function(b){b.disabled=false;});},1200);});\n};});\nfunction metric(text,pattern,id){var match=text.match(pattern);el(id).textContent=match?match[1]:'—';}\nfunction live(){\n request('live').then(function(data){\n  var text=data.stdout||'';\n  el('diagnostics').textContent=text||'Waiting for capture…';\n  metric(text,/(\\d+) regions/,'zones');metric(text,/capture ([\\d.]+)\\/s/,'fps');metric(text,/changed ([\\d.]+)\\/s/,'changes');\n  el('status').textContent=text.indexOf('TV sampled RGB')>=0?'TV color sampler':text.indexOf('HDR10 PQ')>=0?'Full picture · HDR':text.indexOf('SDR BT.709')>=0?'Full picture · SDR':text.indexOf('stopped')>=0?'Stopped':'Waiting for capture…';\n }).catch(function(){el('status').textContent='Capture status unavailable';});\n}\nfunction preview(){\n var canvas=el('strip'),ctx=canvas.getContext('2d');\n request('preview').then(function(data){\n  ctx.clearRect(0,0,768,38);\n  var rgb=atob(data.rgb||'');\n  if(rgb.length!==144){el('previewState').textContent=saved.Lighting==='audio'?'Audio sync runs on WLED':'No recent output';return;}\n  for(var i=0;i<48;i++){\n   ctx.fillStyle='rgb('+rgb.charCodeAt(3*i)+','+rgb.charCodeAt(3*i+1)+','+rgb.charCodeAt(3*i+2)+')';\n   ctx.fillRect(i*16,0,16,38);\n  }\n  el('previewState').textContent='First LED → last LED · refreshed every second';\n }).catch(function(){ctx.clearRect(0,0,768,38);el('previewState').textContent='Preview unavailable';}).then(function(){setTimeout(preview,1000);});\n}\npreview();\nrequest('settings').then(draw).catch(function(e){el('msg').textContent=e.message;});live();setInterval(live,5000);\n</script></html>\n","payload.b64":"","settings.js":"'use strict';\nvar fs = require('fs'), path = require('path');\nvar fields = require('./controls.json');\nfunction valid(f, v) {\n    if (f.type === 'toggle') return typeof v === 'boolean';\n    if (f.type === 'color') return typeof v === 'string' && /^#[0-9a-f]{6}$/i.test(v);\n    if (f.options) return typeof v === 'string' && Object.prototype.hasOwnProperty.call(f.options,v);\n    if (f.type === 'ipv4') return typeof v === 'string' && /^(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)){3}$/.test(v);\n    if (f.choices) return f.choices.indexOf(v) >= 0;\n    return typeof v === 'number' && v === Math.floor(v) && v >= f.min && v <= f.max;\n}\nmodule.exports = function(ctx, status) {\n    function load() {\n        var old = ctx.config.get() || {}, values = {};\n        fields.forEach(function(f){ values[f.key] = valid(f,old[f.key]) ? old[f.key] : f.default; });\n        if (old.TopCount === undefined) {\n            var total=values.Leds, ends=[0,172,269,441,538];\n            ['Top','Right','Bottom','Left'].forEach(function(side,i){\n                values[side+'Count']=Math.round(total*ends[i+1]/538)-Math.round(total*ends[i]/538);\n            });\n        }\n        return values;\n    }\n    var discovery;\n    var current = load();\n    ctx.config.set(current);\n    function json(res,value,code) {\n        res.writeHead(code || 200,{'Content-Type':'application/json','Cache-Control':'no-store'});\n        res.end(JSON.stringify(value));\n    }\n    return function(req,res,sub) {\n        if (sub === 'ui' && req.method === 'GET') {\n            res.writeHead(200,{'Content-Type':'text/html; charset=utf-8','Cache-Control':'no-store'});\n            res.end(fs.readFileSync(path.join(__dirname,'panel.html')));return true;\n        }\n        if (sub === 'settings' && req.method === 'GET') {\n            current=load();\n            json(res,{fields:fields,values:current});return true;\n        }\n        if (sub === 'discover' && req.method === 'POST') {\n            if (!discovery) discovery = require('./discover')().then(function(devices) {\n                discovery = null;\n                return devices;\n            }, function(error) { discovery = null; throw error; });\n            discovery.then(function(devices) { json(res,{devices:devices}); },\n                function(error) { json(res,{error:error.message},503); });\n            return true;\n        }\n        if (sub === 'preview' && req.method === 'GET') {\n            // The capture service and the dashboard can have separate /tmp mounts.\n            // Read in the same execution context used for capture statistics.\n            var readPreview = 'file=/tmp/ambilight-studio-preview; ' +\n                'if [ -r \"$file\" ]; then modified=$(stat -c %Y \"$file\") || exit 1; ' +\n                'age=$(($(date +%s)-modified)); ' +\n                'if [ \"$age\" -ge 0 ] && [ \"$age\" -lt 4 ]; then cat \"$file\"; fi; fi';\n            ctx.execute(readPreview,2000).then(function(result){\n                if (result.exit_code || result.timed_out) return json(res,{error:'Preview read failed'},503);\n                var rgb = (result.stdout || '').trim();\n                json(res,{rgb:/^[A-Za-z0-9+/]{192}$/.test(rgb) ? rgb : ''});\n            },function(){json(res,{error:'Preview unavailable'},503);});\n            return true;\n        }\n        if (sub === 'live' && req.method === 'GET') { json(res,status());return true; }\n        if (sub === 'wled-probe' && req.method === 'POST') {\n            var probeBody='';\n            req.on('data',function(chunk){probeBody+=chunk;});\n            req.on('end',function(){\n                try {\n                    var address=JSON.parse(probeBody).address;\n                    var field=fields.filter(function(item){return item.key==='Wled';})[0];\n                    if(!valid(field,address))throw Error('Enter a valid WLED IPv4 address');\n                    ctx.execute('curl --connect-timeout 2 --max-time 4 -fsS http://'+address+'/json/info',5000)\n                        .then(function(result){\n                            if(result.exit_code || result.timed_out)throw Error('No WLED response at '+address);\n                            var info=JSON.parse(result.stdout);\n                            json(res,{address:address,name:info.name||'WLED',leds:info.leds&&info.leds.count,version:info.ver||''});\n                        }).catch(function(error){json(res,{error:error.message},400);});\n                } catch(error) { json(res,{error:error.message},400); }\n            });\n            return true;\n        }\n        if (sub !== 'settings' || req.method !== 'POST') return false;\n        var body='', size=0;\n        req.on('data',function(chunk){size+=chunk.length;if(size<=4096)body+=chunk;});\n        req.on('end',function(){\n            if(size>4096)return json(res,{error:'Settings payload too large'},413);\n            try {\n                var patch=JSON.parse(body);\n                if(!patch || Array.isArray(patch) || typeof patch!=='object')throw Error('Invalid settings');\n                var next = load();\n                Object.keys(patch).forEach(function(k){\n                    var f=fields.filter(function(item){return item.key===k;})[0];\n                    if (!f || !valid(f,patch[k]))throw Error('Invalid setting: '+k);\n                    next[k]=patch[k];\n                });\n                next.Leds=next.TopCount+next.RightCount+next.BottomCount+next.LeftCount;\n                if(next.Leds<1 || next.Leds>4096) throw Error('The four sides must total 1 to 4096 LEDs.');\n                function save(){ctx.config.set(next);current=next;json(res,{values:current});}\n                if(next.Lighting==='audio' && (current.Lighting!=='audio' || current.Wled!==next.Wled)){\n                    var target='http://'+next.Wled;\n                    ctx.execute('curl -fsS --max-time 3 '+target+'/json/eff',4000).then(function(result){\n                        var names=JSON.parse(result.stdout);\n                        var effect=names.indexOf('Freqwave');\n                        if(effect<0) throw Error('This WLED controller does not advertise the Freqwave audio effect.');\n                        var body=JSON.stringify({on:true,lor:0,seg:[{id:0,on:true,fx:effect}]});\n                        return ctx.execute(\"curl -fsS --max-time 3 -H 'Content-Type: application/json' --data '\"+body+\"' \"+target+'/json/state',4000);\n                    }).then(function(result){\n                        if(result.exit_code || result.timed_out || !JSON.parse(result.stdout).success) throw Error('WLED refused audio sync');\n                        save();\n                    }).catch(function(e){json(res,{error:e.message},400);});\n                } else save();\n            } catch(e){json(res,{error:e.message},400);}\n        });\n        return true;\n    };\n};\n"}}
